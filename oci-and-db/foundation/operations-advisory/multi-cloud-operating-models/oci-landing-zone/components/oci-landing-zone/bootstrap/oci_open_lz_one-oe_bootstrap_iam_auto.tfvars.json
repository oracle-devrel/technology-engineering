{
    "compartments_configuration": {
        "enable_delete": "true",
        "compartments": {
            "CMP-BOOTSTRAP-KEY": {
                "name": "cmp-bootstrap",
                "description": "Bootstrap compartment to enable automation..."
            }
        }
    },
    "dynamic_groups_configuration": {
        "dynamic_groups":{
            "DG-BOOTSTRAP-RUNNERS": {
                "name": "dg-bootstrap-runners",
                "description": "Dynamic groups identifying bootstrap CI runners.",
                "matching_rule": "All {instance.compartment.id = '__OCI_COMPARTMENT_OCID_A13B5E9233__'}"
            }
        }
    },
    "policies_configuration": {
        "enable_cis_benchmark_checks": "false",
        "supplied_policies": {
            "PCY-BOOTSTRAP": {
                "name": "pcy-bootstrap",
                "description": "Policy to bootstrap Landing Zone automation.",
                "compartment_id": "TENANCY-ROOT",
                "statements": [
                    "allow dynamic-group dg-bootstrap-runners to manage all-resources in tenancy"
                ]
            }
        }
    }
}
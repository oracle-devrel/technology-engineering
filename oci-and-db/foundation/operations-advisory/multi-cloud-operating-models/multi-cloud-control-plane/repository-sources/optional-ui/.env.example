# GitHub Integration (GitHub App user-to-server authorization)
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret
GITHUB_AUTH_MODE=github_app
GITHUB_ORG=example-enterprise
MCCP_INSTALLATION_PATH=mccp-installation.json

# Optional: PAT fallback for non-interactive catalog reads only.
# GITHUB_TOKEN=

# Application Settings
# Browser origin allowed by CORS. The callback is derived from the incoming URL.
APP_URL=http://localhost:8011
APP_HOST=0.0.0.0
APP_PORT=8011
# Platform standard vars (Render sets PORT automatically)
HOST=0.0.0.0
# PORT=8011
DEBUG=true
LOG_LEVEL=info
DEFAULT_CLOUD=oci
DEFAULT_REGION=eu-frankfurt-1
DEFAULT_CLOUD_REGIONS=oci:eu-frankfurt-1;azure:westeurope;gcp:europe-west2
CLOUD_REGION_OPTIONS=oci:eu-frankfurt-1,us-phoenix-1,us-ashburn-1,uk-london-1;azure:westeurope;gcp:europe-west2,europe-west4,us-east4

# Session Security (REQUIRED - generate a secure random key for production)
SESSION_SECRET=your-secret-key-change-in-production

# Audit Settings
# Comma-separated prefixes used by gitops audit mode
AUDIT_INFRA_PATHS=oci/,azure/,gcp/

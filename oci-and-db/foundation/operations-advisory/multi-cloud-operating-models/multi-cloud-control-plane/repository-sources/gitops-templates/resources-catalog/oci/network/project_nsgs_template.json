{
  "network_configuration": {
    "default_enable_cis_checks": false,
    "network_configuration_categories": {
      "__PROJECT_NSG_CATEGORY__": {
        "inject_into_existing_vcns": {
          "__PROJECT_VCN_KEY__": {
            "vcn_id": "__PROJECT_VCN_OCID__",
            "network_security_groups": {
              "__NSG_KEY__": {
                "compartment_id": "__NSG_COMPARTMENT_OCID__",
                "display_name": "__NSG_DISPLAY_NAME__",
                "defined_tags": null,
                "freeform_tags": {
                  "Project": "__PROJECT_NAME__",
                  "Tier": "__NSG_TIER__",
                  "ManagedBy": "platform-ci"
                },
                "ingress_rules": {
                  "__INGRESS_RULE_KEY__": {
                    "description": "__INGRESS_RULE_DESCRIPTION__",
                    "protocol": "TCP",
                    "src": "__INGRESS_RULE_SOURCE__",
                    "src_type": "__INGRESS_RULE_SOURCE_TYPE__",
                    "dst_port_min": "__INGRESS_RULE_DST_PORT_MIN__",
                    "dst_port_max": "__INGRESS_RULE_DST_PORT_MAX__"
                  }
                },
                "egress_rules": {
                  "__EGRESS_RULE_KEY__": {
                    "description": "__EGRESS_RULE_DESCRIPTION__",
                    "protocol": "TCP",
                    "dst": "__EGRESS_RULE_DESTINATION__",
                    "dst_type": "__EGRESS_RULE_DESTINATION_TYPE__",
                    "dst_port_min": "__EGRESS_RULE_DST_PORT_MIN__",
                    "dst_port_max": "__EGRESS_RULE_DST_PORT_MAX__"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

# GitHub Integration (OAuth)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_ORG=__CUSTOMER_ORG__
PROJECT_REPO_PREFIX=

# Optional: PAT fallback for non-interactive use
GITHUB_TOKEN=

# Application Settings
APP_URL=http://localhost:8001
APP_HOST=0.0.0.0
APP_PORT=8001
DEFAULT_CLOUD=oci
DEFAULT_REGION=eu-frankfurt-1
DEFAULT_CLOUD_REGIONS=oci:eu-frankfurt-1;azure:westeurope;gcp:europe-west2
CLOUD_REGION_OPTIONS=oci:eu-frankfurt-1,us-phoenix-1,us-ashburn-1,uk-london-1;azure:westeurope;gcp:europe-west2,europe-west4,us-east4

# Session Security (REQUIRED - generate a secure random key for production)
SESSION_SECRET=your-secret-key-change-in-production

# Git Configuration
GIT_AUTHOR_NAME=Multi-Cloud-Plane
GIT_AUTHOR_EMAIL=gitops@multi-cloud-plane.local

# Audit Settings
# Comma-separated prefixes used by gitops audit mode
AUDIT_INFRA_PATHS=oci/,azure/,gcp/,aws/,terraform/

{
  "schema_version": 3,
  "customer_org": "__CUSTOMER_ORG__",
  "core_repositories": {
    "platform_ci": {"repository": "__CUSTOMER_ORG__/platform-ci", "revision": "__PLATFORM_CI_REF__"},
    "project_template": {"repository": "__CUSTOMER_ORG__/nonprod-project-template", "revision": "__PROJECT_TEMPLATE_REF__"},
    "production_project_template": {"repository": "__CUSTOMER_ORG__/prod-project-template", "revision": "__PRODUCTION_PROJECT_TEMPLATE_REF__"},
    "catalogs": {"repository": "__CUSTOMER_ORG__/gitops-templates", "revision": "__CATALOGS_REF__"}
  },
  "project_state_bucket": "__PROJECT_STATE_BUCKET__",
  "workload_orchestrators": {
    "oci": {
      "repository": "oci-landing-zones/terraform-oci-modules-orchestrator",
      "release_branch": "release-2.1.4",
      "revision": "fcf1d7f02c0b4faa1ff55f1776c396452dd51761",
      "database_modules": {
        "repository": "oci-landing-zones/terraform-oci-modules-exadata",
        "release_branch": "release-1.2.0",
        "revision": "55eeee14808f864e450db550530d760f9e0b0105"
      }
    },
    "azure": {
      "repository": "oci-clickops/clickops-orchestrator-azure",
      "release": "mccp-v2.1.0"
    },
    "gcp": {
      "repository": "oci-clickops/clickops-orchestrator-gcp",
      "release": "mccp-v2.1.0"
    }
  },
  "enabled_request_adapters": ["github-pr"],
  "accepted_handoff_schema_versions": [2],
  "repository_layout": {
    "identifier": "shared-nonprod-v2",
    "repository_pattern": "nonprod-<project>",
    "manifest_path": "<cloud>/<environment>/<region>/...",
    "security_profile": "repository-secrets",
    "platform_codeowners": ["__PLATFORM_OWNER__"],
    "environment_allowlist": ["dev", "test", "uat"],
    "rejected_environments": ["prod", "production", "prd", "live"],
    "handoff_path": "environments/<environment>/environment_information.md",
    "environment_contract": {
      "codeowners": ["__ENVIRONMENT_OWNER__"],
      "runner_labels": {"oci": ["self-hosted", "oci", "<environment>"], "azure": ["self-hosted", "azure", "<environment>"], "gcp": ["self-hosted", "gcp", "<environment>"]},
      "supported_clouds": ["oci", "azure", "gcp"],
      "repository_secret": "GITOPS_SECRET_VALUES_<ENVIRONMENT_UPPER>",
      "readiness_marker_variable": "CONTROL_PLANE_READY_<ENVIRONMENT_UPPER>"
    }
  },
  "production_layout": {
    "identifier": "production",
    "repository_pattern": "prod-<project>",
    "manifest_path": "<cloud>/prod/<region>/...",
    "handoff_path": "environments/prod/environment_information.md",
    "security_profile": "repository-secrets",
    "platform_codeowners": ["__PLATFORM_OWNER__"],
    "environment_contract": {
      "codeowners": ["__PROD_OWNER__"],
      "runner_labels": {"oci": ["self-hosted", "oci", "prod"], "azure": ["self-hosted", "azure", "prod"], "gcp": ["self-hosted", "gcp", "prod"]},
      "supported_clouds": ["oci", "azure", "gcp"],
      "repository_secret": "GITOPS_SECRET_VALUES_PROD",
      "readiness_marker_variable": "CONTROL_PLANE_READY_PROD"
    }
  }
}

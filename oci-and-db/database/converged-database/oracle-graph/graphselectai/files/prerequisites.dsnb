        "hasTitle" : false,
        "message" : [
          "\r",
          "%script\r",
          "\r",
          "BEGIN\r",
          "  DBMS_CLOUD_AI.CREATE_PROFILE(\r",
          "  profile_name   => 'genai',\r",
          "  attributes     =>'{\"provider\": \"oci\",\r",
          "                    \"model\" : \"meta.llama-3.3-70b-instruct\",\r",
          "                    \"credential_name\": \"GENAI_CRED_ACCESS\",\r",
          "                    \"object_list\": [{\"owner\": \"schema/username\", \"name\": table\"}],\r",
          "                    \"comments\" : \"true\",\r",
          "                    \"oci_compartment_id\": \"<yours>\"\r",
          "            }');\r",
          "END;"
        ],

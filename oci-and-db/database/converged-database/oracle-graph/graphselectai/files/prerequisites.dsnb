      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 0,
        "title" : "Admin:PL/SQL block grants network access",
        "hasTitle" : true,
        "message" : [
          "%script \r",
          "---It grants the database user YOURUSER permission to make outbound network connections to the specified OCI Generative AI endpoint.\r",
          "BEGIN\r",
          "  DBMS_NETWORK_ACL_ADMIN.APPEND_HOST_ACE(\r",
          "    host => 'inference.generativeai.<your region>.oci.oraclecloud.com',\r",
          "    ace  => xs$ace_type(\r",
          "             privilege_list   => xs$name_list('connect'),\r",
          "             principal_name   => 'YOURUSER',\r",
          "             principal_type   => xs_acl.ptype_db\r",
          "           )\r",
          "  );\r",
          "  COMMIT;\r",
          "END;"
        ],
        "selectedVisualization" : null,
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,

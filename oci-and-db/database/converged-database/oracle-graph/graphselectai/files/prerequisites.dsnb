        "width" : 0,
        "title" : "Grant as Admin",
        "hasTitle" : true,
        "message" : [
          "\r",
          "%script\r",
          "grant execute on DBMS_CLOUD to <user> ; \r",
          "grant execute on DBMS_CLOUD_AI to <user> ;\r",
          "grant EXECUTE on DBMS_Cloud_AI_AGENT to <user> ;\r",
          "grant CREATE ANY INDEX to <user>;\r",
          "grant EXECUTE on DBMS_VECTOR to <user> ;\r"
        ],

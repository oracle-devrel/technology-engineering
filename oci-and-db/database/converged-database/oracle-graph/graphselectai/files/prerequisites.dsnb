        "sizeX" : 0,
        "width" : 0,
        "title" : "OCI CREDENTIALS For GEN AI",
        "hasTitle" : true,
        "message" : [
          "%script\r",
          "-- https://docs.oracle.com/en-us/iaas/autonomous-database-serverless/doc/resource-principal.html\r",
          "--- https://asktom.oracle.com/ords/r/tech/catalog/session-landing-page?p2_event_id=89465624927714168390245006949537731312&clear=2&session=5519550085318\r",
          "\r",
          "%script\r",
          "BEGIN\r",
          "    DBMS_CLOUD.DROP_CREDENTIAL('GENAI_CRED_ACCESS');\r",
          "END;\r",
          "/\r",
          "\r",
          "BEGIN                                                                          \r",
          "\tDBMS_CLOUD.CREATE_CREDENTIAL\r",
          "        (  \r",
          "\t\t    \tcredential_name => 'GENAI_CRED_ACCESS',\r",
          "\t\t\t \tuser_ocid \t\t=> '<enter-user-ocid>',\r",
          "\t\t        tenancy_ocid    => '<enter-tenancy-ocid>',\r",
          "\t\t        private_key     => '<enter-tpriovate-key-value>',\r",
          "\t\t        fingerprint     => '<enter-private-key-fingerprint>'       \r",
          "        );                                                                           \r",
          "END; "
        ],

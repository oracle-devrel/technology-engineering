      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Check profile",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "SELECT attribute_name,\r",
          "       DBMS_LOB.SUBSTR(attribute_value, 4000, 1) AS attribute_value\r",
          "FROM user_cloud_ai_profile_attributes\r",
          "WHERE UPPER(profile_name) = UPPER('OCI_GROK_4_3_BANK_GRAPH')\r",
          "  AND LOWER(attribute_name) IN (\r",
          "      'provider',\r",
          "      'model',\r",
          "      'embedding_model',\r",
          "      'region',\r",
          "      'oci_endpoint_id',\r",
          "      'azure_deployment_name'\r",
          "  )\r",
          "ORDER BY attribute_name;"
        ],

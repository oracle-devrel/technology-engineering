      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "defination of graph using Gen AI service ",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "\r",
          "----- profile name for creating graph: OCI_gpt_propertygraph\r",
          "CREATE PROPERTY GRAPH user.bank_graph\r",
          "  VERTEX TABLES (\r",
          "    \"USER\".\"BANK_ACCOUNTS\" AS \"ACCOUNT\"\r",
          "      PROPERTIES ( \"BALANCE\", \"NAME\" )\r",
          "  )\r",
          "  EDGE TABLES (\r",
          "    \"USER\".\"BANK_TRANSFERS\" AS \"TRANSFER\"\r",
          "      SOURCE KEY ( \"SRC_ACCT_ID\" ) REFERENCES \"ACCOUNT\"( \"ID\" )\r",
          "      DESTINATION KEY ( \"DST_ACCT_ID\" ) REFERENCES \"ACCOUNT\"( \"ID\" )\r",
          "      PROPERTIES ( \"AMOUNT\", \"DESCRIPTION\" )\r",
          "  )\r",
          "  OPTIONS( TRUSTED MODE, DISALLOW MIXED PROPERTY TYPES )"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : {
          "startTime" : 1782914040338,
          "endTime" : 1782914040694,
          "interpreter" : "sql",
          "taskStatus" : "SUCCESS",
          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "Query executed successfully. Affected rows : 0",
              "type" : "TEXT"
            }
          ],
          "forms" : "[]"
        },
        "relations" : [ ],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 0,
        "title" : "Check defination",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "SELECT DBMS_METADATA.GET_DDL(\r",
          "  'PROPERTY_GRAPH',\r",
          "  'BANK_GRAPH'\r",
          ")\r",
          "FROM dual;"
        ],
        "selectedVisualization" : null,
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : null,

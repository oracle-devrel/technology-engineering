        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Create profile",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "BEGIN\r",
          "  BEGIN\r",
          "    DBMS_CLOUD_AI.DROP_PROFILE(\r",
          "      profile_name => 'OCI_GROK_4_3_BANK_GRAPH',\r",
          "      force        => TRUE\r",
          "    );\r",
          "  EXCEPTION\r",
          "    WHEN OTHERS THEN NULL;  -- profile may not exist yet\r",
          "  END;\r",
          "\r",
          "  DBMS_CLOUD_AI.CREATE_PROFILE(\r",
          "    profile_name => 'OCI_GROK_4_3_BANK_GRAPH',\r",
          "    attributes   => '{\r",
          "      \"provider\": \"oci\",\r",
          "      \"credential_name\": \"GENAI_CRED\",\r",
          "      \"model\": \"xai.grok-4.3\",\r",
          "      \"temperature\": 0.2,\r",
          "      \"max_tokens\": 4096,\r",
          "      \"object_list\": [\r",
          "        {\r",
          "          \"owner\": \"USER\",\r",
          "          \"name\": \"BANK_GRAPH\"\r",
          "        }\r",
          "      ]\r",
          "    }',\r",
          "    description => 'Grok 4.3 Select AI profile for BANK_GRAPH'\r",
          "  );\r",
          "\r",
          "  DBMS_CLOUD_AI.SET_PROFILE(\r",
          "    profile_name => 'OCI_GROK_4_3_BANK_GRAPH'\r",
          "  );\r",
          "END;\r",
          "/"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : true,
        "forms" : "[]",
        "result" : {
          "startTime" : 1787756187452,
          "endTime" : 1787756188157,
          "interpreter" : "sql",
          "taskStatus" : "SUCCESS",
          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "\nPL/SQL procedure successfully completed.\n\n",
              "type" : "TEXT"
            }
          ],
          "forms" : "[]"

        "message" : [
          "%sql\r",
          "SELECT\r",
          "    r.cluster_id,\r",
          "    COUNT(*) AS account_count,\r",
          "    ROUND(AVG(f.cycle_2_norm), 2) AS avg_cycle_2,\r",
          "    ROUND(AVG(f.cycle_3_norm), 2) AS avg_cycle_3,\r",
          "    ROUND(AVG(f.cycle_4_norm), 2) AS avg_cycle_4\r",
          "FROM bank_cycle_cluster_results r\r",
          "JOIN bank_graph_features_normalized f\r",
          "  ON f.account_id = r.account_id\r",
          "GROUP BY r.cluster_id\r",
          "ORDER BY r.cluster_id;"
        ],

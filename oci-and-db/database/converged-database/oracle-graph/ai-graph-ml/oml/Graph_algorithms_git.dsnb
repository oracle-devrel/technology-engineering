      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "View Cycle-Cluster Centroid Means (Five Clusters: IDs 5–9)",
        "hasTitle" : true,
        "message" : [
          "%python\r",
          "# ---A K-Means cluster is defined by its centroid means\r",
          "# It shows the centroid values that K-Means uses to group accounts closest to each cluster\r",
          "centroids = cycle_model.centroids.pull()\r",
          "\r",
          "centroids[\r",
          "    (centroids[\"CLUSTER_ID\"] >= 5)\r",
          "    & (centroids[\"ATTRIBUTE_NAME\"].isin(\r",
          "        [\"CYCLE_2_NORM\", \"CYCLE_3_NORM\", \"CYCLE_4_NORM\"]\r",
          "    ))\r",
          "][[\"CLUSTER_ID\", \"ATTRIBUTE_NAME\", \"MEAN\"]]\r",
          "\r",
          "# It shows each cluster ID and the average value of each cycle metric in that cluster.\r",
          "# for example: Each cluster ID has a different average value for CYCLE_2_NORM.\r"
        ],

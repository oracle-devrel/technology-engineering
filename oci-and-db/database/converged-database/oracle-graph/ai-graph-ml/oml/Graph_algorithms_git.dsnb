        "message" : [
          "%sql\r",
          "CREATE TABLE bank_graph_cluster_results AS\r",
          "SELECT\r",
          "    f.account_id,\r",
          "    f.cycle_2_norm,\r",
          "    f.cycle_3_norm,\r",
          "    f.cycle_4_norm,\r",
          "    f.pagerank_norm,\r",
          "    f.betweenness_norm,\r",
          "    f.closeness_norm,\r",
          "    c.cluster_id AS cycle_cluster_id,\r",
          "    i.cluster_id AS importance_cluster_id\r",
          "FROM bank_graph_features_normalized f\r",
          "JOIN bank_cycle_cluster_results c\r",
          "  ON c.account_id = f.account_id\r",
          "JOIN bank_importance_cluster_results i\r",
          "  ON i.account_id = f.account_id;"
        ],

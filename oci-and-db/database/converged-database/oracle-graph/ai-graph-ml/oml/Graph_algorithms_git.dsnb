      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Train and Save K-Means Model (Five Clusters) for  \"PAGERANK_NORM\", \"BETWEENNESS_NORM\", \"CLOSENESS_NORM\"",
        "hasTitle" : true,
        "message" : [
          "%python\r",
          "\r",
          "# Group accounts by their graph importance behaviour.\r",
          "importance_input = bank_features[\r",
          "    [\"ACCOUNT_ID\", \"PAGERANK_NORM\", \"BETWEENNESS_NORM\", \"CLOSENESS_NORM\"]\r",
          "]\r",
          "\r",
          "importance_settings = {\r",
          "    \"KMNS_ITERATIONS\": 50,\r",
          "    \"KMNS_DISTANCE\": \"KMNS_EUCLIDEAN\",\r",
          "    \"KMNS_DETAILS\": \"KMNS_DETAILS_ALL\",\r",
          "    \"PREP_AUTO\": \"OFF\"\r",
          "}\r",
          "\r",
          "# Train and save five importance groups in Oracle Database.\r",
          "importance_model = oml.km(n_clusters=5, **importance_settings).fit(\r",
          "    importance_input,\r",
          "    model_name=\"BANK_IMPORTANCE_KMEANS_MODEL\",\r",
          "    case_id=\"ACCOUNT_ID\"\r",
          ")\r",
          "\r",
          "# print(importance_m/odel)\r",
          "print(\"BANK_IMPORTANCE_KMEANS_MODEL trained: 5 clusters\")\r",
          "print(\"Features: PageRank, Betweenness, Closeness\")"
        ],

        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Add the key and account relationships for the new table ",
        "hasTitle" : true,
        "message" : [
          "ALTER TABLE bank_transfers_augmented\r",
          "  ADD CONSTRAINT btaug_pk PRIMARY KEY (txn_id);\r",
          "\r",
          "ALTER TABLE bank_transfers_augmented\r",
          "  ADD CONSTRAINT btaug_src_fk\r",
          "  FOREIGN KEY (src_acct_id) REFERENCES bank_accounts(id);\r",
          "\r",
          "ALTER TABLE bank_transfers_augmented\r",
          "  ADD CONSTRAINT btaug_dst_fk\r",
          "  FOREIGN KEY (dst_acct_id) REFERENCES bank_accounts(id);"
        ],

        "title" : "Verify Foreign-Key Constraints for Synthetic Transfers",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "\r",
          "/* Both are ENABLED, so Oracle enforces those account relationships. */\r",
          "\r",
          "SELECT constraint_name, status\r",
          "FROM user_constraints\r",
          "WHERE table_name = 'BANK_TRANSFERS_SYNTHETIC'\r",
          "  AND constraint_type = 'R';"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,

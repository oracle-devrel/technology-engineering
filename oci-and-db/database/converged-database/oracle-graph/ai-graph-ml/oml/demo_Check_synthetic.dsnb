        "message" : [
          "\r",
          "\r",
          "%sql\r",
          "SELECT comp_id, COUNT(*) AS total_accounts\r",
          "FROM GRAPH_TABLE (\r",
          "  DBMS_OGA.WCC(\r",
          "    BANK_GRAPH_AUGMENTED_CLUSTER,\r",
          "    PROPERTY(VERTEX OUTPUT comp_id)\r",
          "  )\r",
          "  MATCH (a)\r",
          "  COLUMNS (a.comp_id AS comp_id)\r",
          ")\r",
          "GROUP BY comp_id\r",
          "ORDER BY comp_id;"
        ],

      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "new graph and keep the bank graph unchanged",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "CREATE PROPERTY GRAPH bank_graph_augmented\r",
          "  VERTEX TABLES (\r",
          "    bank_accounts\r",
          "      KEY (id)\r",
          "      LABEL \"ACCOUNTS\" PROPERTIES (id, name, balance)\r",
          "  )\r",
          "  EDGE TABLES (\r",
          "    bank_transfers_augmented\r",
          "      KEY (txn_id)\r",
          "      SOURCE KEY (src_acct_id) REFERENCES bank_accounts(id)\r",
          "      DESTINATION KEY (dst_acct_id) REFERENCES bank_accounts(id)\r",
          "      LABEL \"TRANSFERS\" PROPERTIES (src_acct_id, dst_acct_id, amount)\r",
          "  )\r",
          "  OPTIONS (TRUSTED MODE, DISALLOW MIXED PROPERTY TYPES);"
        ],

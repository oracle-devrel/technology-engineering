          "%sql\r",
          "CREATE TABLE bank_cycle_2 AS\r",
          "SELECT account_id, COUNT(*) AS cycle_count\r",
          "FROM GRAPH_TABLE (\r",
          "  bank_graph_augmented\r",
          "  MATCH (a IS ACCOUNTS)-[e IS TRANSFERS]->{2}(a)\r",
          "  WHERE COUNT(EDGE_ID(e)) = COUNT(DISTINCT EDGE_ID(e))\r",
          "  COLUMNS (a.ID AS account_id)\r",
          ")\r",

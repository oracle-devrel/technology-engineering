      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Create BANK_TRANSFERS_AUGMENTED from:  BANK_TRANSFERS and BANK_TRANSFERS_SYNTHETIC",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "CREATE TABLE bank_transfers_augmented AS\r",
          "SELECT txn_id, src_acct_id, dst_acct_id, amount\r",
          "FROM bank_transfers\r",
          "\r",
          "UNION ALL\r",
          "\r",
          "SELECT txn_id, src_acct_id, dst_acct_id, amount\r",
          "FROM bank_transfers_synthetic;"
        ],
        "selectedVisualization" : "raw",

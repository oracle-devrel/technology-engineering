      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Validate Synthetic Transfer Connections to BANK_ACCOUNTS Through Joins",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "\r",
          "/* The transfer amount is synthetic; the account IDs and holder names come from BANK_ACCOUNTS */\r",
          "\r",
          "SELECT t.txn_id,\r",
          "       t.src_acct_id,\r",
          "       src.name AS source_account_name,\r",
          "       t.dst_acct_id,\r",
          "       dst.name AS destination_account_name,\r",
          "       t.amount\r",
          "FROM bank_transfers_synthetic t\r",
          "JOIN bank_accounts src\r",
          "  ON src.id = t.src_acct_id\r",
          "JOIN bank_accounts dst\r",
          "  ON dst.id = t.dst_acct_id\r",
          "FETCH FIRST 20 ROWS ONLY;"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : null,

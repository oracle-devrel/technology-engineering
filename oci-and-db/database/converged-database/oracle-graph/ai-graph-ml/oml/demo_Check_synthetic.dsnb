        "sizeX" : 0,
        "width" : 6,
        "title" : "Which accounts receive the most transfers?\n",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "SELECT acct_id, COUNT(1) AS Num_Transfers \r",
          "FROM graph_table ( BANK_GRAPH_AUGMENTED \r",
          "    MATCH (src) - [IS TRANSFERS] -> (dst) \r",
          "    COLUMNS ( dst.id AS acct_id )\r",
          ") GROUP BY acct_id ORDER BY Num_Transfers DESC FETCH FIRST 10 ROWS ONLY;"
        ],

        "width" : 12,
        "title" : "Weakly Connected Components(WCC)",
        "hasTitle" : true,
        "message" : [
          "\r",
          "%sql\r",
          "\r",
          "SELECT comp_id, COUNT(*) AS total_accounts\r",
          "FROM GRAPH_TABLE (\r",
          "  DBMS_OGA.wcc (\r",
          "    \"GRAPH\".\"BANK_GRAPH_AUGMENTED\",\r",
          "    PROPERTY(VERTEX OUTPUT comp_id)\r",
          "  )\r",
          "  MATCH (a is ACCOUNTS)\r",
          "  COLUMNS (a.comp_id AS comp_id)\r",
          ")\r",
          "GROUP BY comp_id;"
        ],

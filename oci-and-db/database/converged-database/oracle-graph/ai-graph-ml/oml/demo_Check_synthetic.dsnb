        "message" : [
          "%sql\r",
          "SELECT *\r",
          "FROM GRAPH_TABLE (\r",
          "    bank_graph_augmented_cluster\r",
          "    MATCH (a)-[e]->{2,4}(b)\r",
          "    WHERE a.cycle_cluster_id = 9\r",
          "      AND a.importance_cluster_id = 5\r",
          "      AND b.cycle_cluster_id = 9\r",
          "      AND b.importance_cluster_id = 5\r",
          "    COLUMNS (\r",
          "        a.id AS source_account_id,\r",
          "        a.name AS source_account_name,\r",
          "        b.id AS destination_account_id,\r",
          "        b.name AS destination_account_name,\r",
          "        COUNT(EDGE_ID(e)) AS hop_count\r",
          "    )\r",
          ");"
        ],

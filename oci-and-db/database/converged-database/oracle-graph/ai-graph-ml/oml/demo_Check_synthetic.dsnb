        "hasTitle" : false,
        "message" : [
          "%sql\r",
          "CREATE PROPERTY GRAPH bank_graph_augmented_cluster\r",
          "VERTEX TABLES (\r",
          "    bank_accounts_clustered_v\r",
          "        KEY (id)\r",
          "        PROPERTIES (\r",
          "            id,\r",
          "            name,\r",
          "            balance,\r",
          "            cycle_2_norm,\r",
          "            cycle_3_norm,\r",
          "            cycle_4_norm,\r",
          "            pagerank_norm,\r",
          "            betweenness_norm,\r",
          "            closeness_norm,\r",
          "            cycle_cluster_id,\r",
          "            importance_cluster_id\r",
          "        )\r",
          ")\r",
          "EDGE TABLES (\r",
          "    bank_transfers_augmented\r",
          "        KEY (txn_id)\r",
          "        SOURCE KEY (src_acct_id)\r",
          "            REFERENCES bank_accounts_clustered_v (id)\r",
          "        DESTINATION KEY (dst_acct_id)\r",
          "            REFERENCES bank_accounts_clustered_v (id)\r",
          "        PROPERTIES (\r",
          "            txn_id,\r",
          "            src_acct_id,\r",
          "            dst_acct_id,\r",
          "            amount\r",
          "        )\r",
          ");"
        ],

        "message" : [
          "%sql\r",
          "CREATE TABLE bank_graph_features AS\r",
          "SELECT\r",
          "  a.id AS account_id,\r",
          "\r",
          "  NVL(c2.cycle_count, 0) AS cycle_2_count,\r",
          "  NVL(c3.cycle_count, 0) AS cycle_3_count,\r",
          "  NVL(c4.cycle_count, 0) AS cycle_4_count,\r",
          "\r",
          "  NVL(pr.pagerank_score, 0) AS pagerank_score,\r",
          "  NVL(b.\"betweenness_score\", 0) AS betweenness_score,\r",
          "  NVL(cl.\"closeness_score\", 0) AS closeness_score\r",
          "\r",
          "FROM bank_accounts a\r",
          "LEFT JOIN bank_cycle_2 c2\r",
          "  ON c2.account_id = a.id\r",
          "LEFT JOIN bank_cycle_3 c3\r",
          "  ON c3.account_id = a.id\r",
          "LEFT JOIN bank_cycle_4 c4\r",
          "  ON c4.account_id = a.id\r",
          "LEFT JOIN bank_pagerank_metrics pr\r",
          "  ON pr.id_account = a.id\r",
          "LEFT JOIN bank_betweenness_metrics b\r",
          "  ON b.\"account_id\" = a.id\r",
          "LEFT JOIN bank_closeness_metrics cl\r",
          "  ON cl.\"account_id\" = a.id;"
        ],

      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Normalize metrics between 0 and 100",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "CREATE TABLE bank_graph_features_normalized AS\r",
          "WITH bounds AS (\r",
          "  SELECT\r",
          "    MIN(cycle_2_count) AS min_c2, MAX(cycle_2_count) AS max_c2,\r",
          "    MIN(cycle_3_count) AS min_c3, MAX(cycle_3_count) AS max_c3,\r",
          "    MIN(cycle_4_count) AS min_c4, MAX(cycle_4_count) AS max_c4,\r",
          "    MIN(pagerank_score) AS min_pr, MAX(pagerank_score) AS max_pr,\r",
          "    MIN(betweenness_score) AS min_bt, MAX(betweenness_score) AS max_bt,\r",
          "    MIN(closeness_score) AS min_cl, MAX(closeness_score) AS max_cl\r",
          "  FROM bank_graph_features\r",
          ")\r",
          "SELECT\r",
          "  f.account_id,\r",
          "\r",
          "  NVL(100 * (f.cycle_2_count - b.min_c2) / NULLIF(b.max_c2 - b.min_c2, 0), 0) AS cycle_2_norm,\r",
          "  NVL(100 * (f.cycle_3_count - b.min_c3) / NULLIF(b.max_c3 - b.min_c3, 0), 0) AS cycle_3_norm,\r",
          "  NVL(100 * (f.cycle_4_count - b.min_c4) / NULLIF(b.max_c4 - b.min_c4, 0), 0) AS cycle_4_norm,\r",
          "\r",
          "  NVL(100 * (f.pagerank_score - b.min_pr) / NULLIF(b.max_pr - b.min_pr, 0), 0) AS pagerank_norm,\r",
          "  NVL(100 * (f.betweenness_score - b.min_bt) / NULLIF(b.max_bt - b.min_bt, 0), 0) AS betweenness_norm,\r",
          "  NVL(100 * (f.closeness_score - b.min_cl) / NULLIF(b.max_cl - b.min_cl, 0), 0) AS closeness_norm\r",
          "\r",
          "FROM bank_graph_features f\r",
          "CROSS JOIN bounds b;"
        ],

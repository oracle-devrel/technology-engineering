        "hasTitle" : false,
        "message" : [
          "%sql\r",
          "\r",
          "SELECT *\r",
          "FROM GRAPH_TABLE (\r",
          "  bank_graph_augmented_cluster\r",
          "  MATCH (a)-[e]->(b)\r",
          "  WHERE a.cycle_cluster_id = 3\r",
          "    AND a.importance_cluster_id = 3\r",
          "    AND (\r",
          "      b.cycle_cluster_id <> 3\r",
          "      OR b.importance_cluster_id <> 3\r",
          "    )\r",
          "  COLUMNS (\r",
          "    a.id AS group_account_id,\r",
          "    a.name AS group_account_name,\r",
          "    a.pagerank_norm,\r",
          "    a.betweenness_norm,\r",
          "    a.closeness_norm,\r",
          "    e.txn_id,\r",
          "    e.amount,\r",
          "    b.id AS outside_account_id,\r",
          "    b.name AS outside_account_name,\r",
          "    b.cycle_cluster_id AS outside_cycle_cluster,\r",
          "    b.importance_cluster_id AS outside_importance_cluster,\r",
          "    VERTEX_ID(a) AS a_id,\r",
          "    EDGE_ID(e) AS e_id,\r",
          "    VERTEX_ID(b) AS b_id\r",
          "  )\r",
          ")\r",
          "ORDER BY betweenness_norm DESC, pagerank_norm DESC;"
        ],

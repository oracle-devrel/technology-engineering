        "title" : null,
        "hasTitle" : false,
        "message" : [
          "%sql\r",
          "CREATE VIEW bank_accounts_clustered_v AS\r",
          "SELECT\r",
          "    a.id,\r",
          "    a.name,\r",
          "    a.balance,\r",
          "    r.cycle_2_norm,\r",
          "    r.cycle_3_norm,\r",
          "    r.cycle_4_norm,\r",
          "    r.pagerank_norm,\r",
          "    r.betweenness_norm,\r",
          "    r.closeness_norm,\r",
          "    r.cycle_cluster_id,\r",
          "    r.importance_cluster_id\r",
          "FROM bank_accounts a\r",
          "JOIN bank_graph_cluster_results r\r",
          "  ON r.account_id = a.id;"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,

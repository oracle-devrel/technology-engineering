        "message" : [
          "%sql\r",
          "\r",
          "SELECT *\r",
          "FROM GRAPH_TABLE (\r",
          "  bank_graph_augmented_cluster\r",
          "  MATCH (a)-[e]->(b)\r",
          "  WHERE a.cycle_cluster_id = 9\r",
          "    AND a.importance_cluster_id = 5\r",
          "    AND (\r",
          "      b.cycle_cluster_id <> 9\r",
          "      OR b.importance_cluster_id <> 5\r",
          "    )\r",
          "  COLUMNS (\r",

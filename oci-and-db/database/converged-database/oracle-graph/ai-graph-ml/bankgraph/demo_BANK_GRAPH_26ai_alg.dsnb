        "sizeX" : 0,
        "width" : 12,
        "title" : "Personalized Page rank for 387 Id: Which accounts are most closely connected to account 387?",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "\r",
          "\r",
          "SELECT *\r",
          "FROM GRAPH_TABLE (\r",
          "  DBMS_OGA.personalized_pagerank(\r",
          "    bank_graph,\r",
          "    PROPERTY(VERTEX OUTPUT rank),\r",
          "    JSON('{\r",
          "      \"GRAPH_OWNER\": \"USER\",\r",
          "      \"GRAPH_NAME\": \"BANK_GRAPH\",\r",
          "      \"ELEM_TABLE\": \"BANK_ACCOUNTS\",\r",
          "      \"KEY_VALUE\": { \"ID\": 387 }\r",
          "    }'),\r",
          "    100,\r",
          "    1e-6,\r",
          "    0.85d,\r",
          "    TRUE\r",
          "  )\r",
          "  MATCH (a IS BANK_ACCOUNTS)\r",
          "  COLUMNS (a.ID AS account_id, a.rank)\r",
          ")\r",
          "ORDER BY rank DESC;"
        ],

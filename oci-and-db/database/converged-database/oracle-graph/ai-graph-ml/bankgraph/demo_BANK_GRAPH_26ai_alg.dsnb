          "%sql\r",
          "/* 135 has a similar connection pattern to 934 and 387. Deepwalk helps you match such patterns in the graph. */\r",
          "SELECT * \r",
          "FROM graph_table (BANK_GRAPH \r",
          "    MATCH (a)-[e1]->(m)-[e2]->(d) \r",
          "    WHERE a.id in (934, 387, 135)\r",

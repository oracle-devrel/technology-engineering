        "width" : 12,
        "title" : null,
        "hasTitle" : false,
        "message" : [
          "This query isolates intermediary \"broker\" nodes by searching the graph topology for accounts that sit directly between two distinct core cluster nodes (specified by their IDs). \r",
          "It filters for paths where both endpoints (c1 and c2) belong to the designated list of major hubs, effectively extracting the quiet connecting links or secondary bridges that span across separate clusters.\r",
          "AND c1.id <> c2.id: Ensures that the two hubs are different clusters, meaning node x is truly bridging two separate groups rather than just looping back into the same one."
        ],
        "selectedVisualization" : "html",
        "visualizationConfig" : null,
        "hideCode" : true,
        "hideResult" : false,
        "hideGutter" : true,

          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "<p>If we ask :&quot;Which accounts have many cycles?&quot; it aggregates/counts the cycle paths by: account_id + hop_count  934 | 4 hops | 27 cycles . So account 934 has 27 distinct 5-hop cycle paths in BANK_GRAPH</p>\n",
              "type" : "HTML"
            }
          ],
          "forms" : "[]"
        },
        "relations" : [ ],
        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : null,
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "\r",
          "SELECT\r",
          "  account_id,\r",
          "  hop_count,\r",
          "  COUNT(*) AS cycle_count\r",
          "FROM GRAPH_TABLE (\r",
          "  BANK_GRAPH\r",
          "  MATCH (a IS BANK_ACCOUNTS)\r",
          "        -[e IS BANK_TRANSFERS]->{2,5}\r",
          "        (a)\r",
          "  WHERE COUNT(EDGE_ID(e)) = COUNT(DISTINCT EDGE_ID(e))\r",
          "  COLUMNS (\r",
          "    a.ID AS account_id,\r",
          "    COUNT(EDGE_ID(e)) AS hop_count\r",
          "  )\r",
          ")\r",
          "GROUP BY account_id, hop_count\r",
          "ORDER BY cycle_count DESC, account_id;"
        ],
        "selectedVisualization" : "table",
        "visualizationConfig" : null,

        "title" : " Which accounts directly connect the selected major hubs?",
        "hasTitle" : true,
        "message" : [
          "%pgql-pgx\r",
          "SELECT DISTINCT x.id \r",
          "FROM MATCH (c1:bank_accounts)-(x)-(c2:bank_accounts) ON bank_graph\r",
          "WHERE c1.id IN (387, 352, 135, 934) \r",
          "  AND c2.id IN (387, 352, 135, 934)\r",
          "  AND c1.id <> c2.id"
        ],

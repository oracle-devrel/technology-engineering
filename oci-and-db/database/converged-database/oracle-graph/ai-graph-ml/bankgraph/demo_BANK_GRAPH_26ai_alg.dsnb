      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Pagerank to check centrality: Which accounts are the most influential in the payment network?",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "\r",
          "SELECT \r",
          "  id_account, \r",
          "  pagerank_score\r",
          "FROM GRAPH_TABLE(\r",
          "  DBMS_OGA.PAGERANK(\r",
          "    \"USER\".\"BANK_GRAPH\",\r",
          "    PROPERTY(VERTEX OUTPUT pagerank_score),\r",
          "    100,      -- max_iter\r",
          "    1e-6,     -- tolerance (stop criteria)\r",
          "    0.85d,    -- damping factor\r",
          "    FALSE     -- handle dangling nodes\r",
          "  )\r",
          "  MATCH (a )\r",
          "  COLUMNS (\r",
          "    a.ID AS id_account,\r",
          "    a.pagerank_score AS pagerank_score\r",
          "  )\r",
          ")\r",
          "ORDER BY pagerank_score DESC\r",
          "FETCH FIRST 5 ROWS ONLY;"
        ],

        "message" : [
          "\r",
          "%sql \r",
          "\r",
          "SELECT *\r",
          "FROM GRAPH_TABLE (\r",
          "  DBMS_OGA.personalized_pagerank_set(\r",
          "    bank_graph,\r",
          "    PROPERTY(VERTEX OUTPUT rank),\r",
          "    JSON('[\r",

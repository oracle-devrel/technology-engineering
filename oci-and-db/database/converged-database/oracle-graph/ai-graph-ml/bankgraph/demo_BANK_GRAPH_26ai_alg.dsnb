        "title" : "How are accounts 934, 387, and 135 connected?",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "/* 135 has a similar connection pattern to 934 and 387. Deepwalk helps you match such patterns in the graph. */\r",
          "SELECT * \r",
          "FROM graph_table (BANK_GRAPH \r",
          "    MATCH (a)-[e1]->(m)-[e2]->(d) \r",
          "    WHERE a.id in (934, 387, 135)\r",
          "    COLUMNS (vertex_id(a) as a_id, edge_id(e1) as e1_id, vertex_id(m) as m_id, edge_id(e2) as e2_id, vertex_id(d) as d_id ) \r",
          ") "
        ],

        "title" : "all vertex and edge labels",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "\r",
          "SELECT l.label_name,\r",
          "       e.element_name,\r",
          "       e.element_kind\r",
          "FROM user_pg_element_labels l\r",
          "JOIN user_pg_elements e\r",
          "  ON e.graph_name = l.graph_name\r",
          " AND e.element_name = l.element_name\r",
          "WHERE l.graph_name = 'BANK_GRAPH'\r",
          "ORDER BY e.element_kind, l.label_name;"
        ],

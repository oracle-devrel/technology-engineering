          "results" : [
            {
              "message" : "<p>Let's use SQL to find the <strong>top 10 accounts by number of transfers</strong> the account has received.</p>\n<p>Run the paragraph with the following query.</p>\n",
              "type" : "HTML"
            }
          ],
          "forms" : "[]"

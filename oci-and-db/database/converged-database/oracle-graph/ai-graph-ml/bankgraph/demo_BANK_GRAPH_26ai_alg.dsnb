        "width" : 12,
        "title" : "Overview of Graph:Which accounts are connected by transfers, and what are the transfer amounts?",
        "hasTitle" : true,
        "message" : [
          "",
          "%sql",
          "SELECT v1_id, v2_id, edge_id, account_id, transfer_amount",
          "FROM GRAPH_TABLE(",
          "  \"USER\".\"BANK_GRAPH\"",
          "  MATCH (a1)-[t]->(a2)",
          "  COLUMNS (",
          "    VERTEX_ID(a1) AS v1_id,",
          "    VERTEX_ID(a2) AS v2_id,",
          "    EDGE_ID(t)    AS edge_id,",
          "    a1.ID         AS account_id,",
          "    t.AMOUNT      AS transfer_amount",
          "  )",
          ")",
          "/* FETCH FIRST 100 ROWS ONLY; */"
        ],

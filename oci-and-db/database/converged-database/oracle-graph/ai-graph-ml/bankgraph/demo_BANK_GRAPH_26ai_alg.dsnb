      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Which exact transfers form those cycles?",
        "hasTitle" : true,
        "message" : [
          "",
          "%sql",
          "",
          "SELECT",
          "  account_id,",
          "  hop_count,",
          "  cycle_path",
          "FROM GRAPH_TABLE (",
          "  BANK_GRAPH",
          "  MATCH (a IS BANK_ACCOUNTS)",
          "        -[e IS BANK_TRANSFERS]->{2,5}",
          "        (a)",
          "  WHERE COUNT(EDGE_ID(e)) = COUNT(DISTINCT EDGE_ID(e))",
          "  COLUMNS (",
          "    a.ID AS account_id,",
          "    COUNT(EDGE_ID(e)) AS hop_count,",
          "    LISTAGG(EDGE_ID(e), ', ') AS cycle_path",
          "  )",
          ")",
          "ORDER BY account_id, hop_count;"
        ],

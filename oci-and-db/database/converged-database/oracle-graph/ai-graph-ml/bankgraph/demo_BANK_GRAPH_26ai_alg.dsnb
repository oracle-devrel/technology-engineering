        "dynamicFormParams" : "{}"
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "Create a graph",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "CREATE PROPERTY GRAPH BANK_GRAPH \r",
          "VERTEX TABLES (\r",
          "    BANK_ACCOUNTS\r",
          "    KEY (ID)\r",
          "    PROPERTIES (ID, Name, Balance) \r",
          ")\r",
          "EDGE TABLES (\r",
          "    BANK_TRANSFERS \r",
          "    KEY (TXN_ID) \r",
          "    SOURCE KEY (src_acct_id) REFERENCES BANK_ACCOUNTS(ID)\r",
          "    DESTINATION KEY (dst_acct_id) REFERENCES BANK_ACCOUNTS(ID)\r",
          "    PROPERTIES (src_acct_id, dst_acct_id, amount) \r",
          "    )\r"
        ],
        "selectedVisualization" : "raw",
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,
        "hideInIFrame" : false,
        "enabled" : false,
        "forms" : "[]",
        "result" : null,
        "relations" : [ ],
        "dynamicFormParams" : null
      },
      {
        "row" : 0,
        "col" : 0,
        "sizeX" : 0,
        "width" : 12,
        "title" : "With Label",
        "hasTitle" : true,
        "message" : [
          "%sql\r",
          "\r",
          "CREATE PROPERTY GRAPH GRAPH.bank_graph_test\r",
          "  VERTEX TABLES (\r",
          "    \"USER\".\"BANK_ACCOUNTS\"\r",
          "      KEY ( \"ID\" )\r",
          "     LABEL \"ACCOUNTS\" PROPERTIES ( \"ID\", \"NAME\", \"BALANCE\" )\r",
          "  )\r",
          "  EDGE TABLES (\r",
          "    \"USER\".\"BANK_TRANSFERS\" KEY ( \"TXN_ID\" )\r",
          "      SOURCE KEY ( \"SRC_ACCT_ID\" ) REFERENCES \"BANK_ACCOUNTS\"( \"ID\" )\r",
          "      DESTINATION KEY ( \"DST_ACCT_ID\" ) REFERENCES \"BANK_ACCOUNTS\"( \"ID\" )\r",
          "      LABEL \"TRANSFERS\" PROPERTIES ( \"SRC_ACCT_ID\", \"DST_ACCT_ID\", \"AMOUNT\" )\r",
          "  )\r",
          "  OPTIONS( TRUSTED MODE, DISALLOW MIXED PROPERTY TYPES )"
        ],
        "selectedVisualization" : null,
        "visualizationConfig" : null,
        "hideCode" : false,
        "hideResult" : false,
        "hideGutter" : true,
        "hideVizConfig" : false,

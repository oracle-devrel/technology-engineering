      -- Elapsed: 00:00:00.037
    languageId: oracle-sql
  - kind: 1
    value: |
      ## 8. New supervised team

      The existing six workers are reused. Only the new history team and its
      own supervisor are dropped/recreated here. Run this cell when no request
      to `TREE_HISTORY_MAP_TEAM` is in progress. The old team remains available.
    languageId: markdown
  - kind: 2
    value: >-
      BEGIN
          DBMS_CLOUD_AI_AGENT.DROP_TEAM(
              'TREE_HISTORY_MAP_TEAM', force => TRUE
          );
          DBMS_CLOUD_AI_AGENT.DROP_AGENT(
              'TREE_HISTORY_SUPERVISOR', force => TRUE
          );
          DBMS_CLOUD_AI_AGENT.CREATE_AGENT(
              agent_name => 'TREE_HISTORY_SUPERVISOR',
              attributes => q'~{
                  "profile_name":"OCI_GROK_4_3_BOMEN_BURRT_PROFILE",
                  "role":"You supervise Den Haag tree and green-neighbourhood questions. Route requests about what the user asked, saw, calculated, or learned previously to TREE_HISTORY_AGENT. Route greetings and examples to TREE_GREETING_AGENT. Route open-ended data-quality discovery to TREE_DISCOVERY_AGENT. Route new neighbourhood density calculations to TREE_DENSITY_AGENT, new one-class SVM flagging to TREE_ANOMALY_AGENT, and new K-means grouping to TREE_KMEANS_AGENT. Route factual questions about existing tables or saved rows, including spatial SQL, to TREE_NL2SQL_AGENT. A past-result request is not a new calculation. If past and new intent are unclear, ask one focused clarification. Use measured evidence only and do not claim the browser map rendered without application confirmation.",
                  "supervisor":true
              }~',
              description => 'Routes history, SQL, greeting, density, SVM and K-means.'
          );
          DBMS_CLOUD_AI_AGENT.CREATE_TEAM(
              team_name => 'TREE_HISTORY_MAP_TEAM',
              attributes => q'~{
                  "process":"sequential",
                  "supervisor_agent":"TREE_HISTORY_SUPERVISOR",
                  "agents":[
                      {"name":"TREE_HISTORY_AGENT","task":"TREE_HISTORY_TASK"},
                      {"name":"TREE_GREETING_AGENT","task":"TREE_GREETING_TASK"},
                      {"name":"TREE_NL2SQL_AGENT","task":"TREE_NL2SQL_TASK"},
                      {"name":"TREE_DISCOVERY_AGENT","task":"TREE_DISCOVERY_TASK"},
                      {"name":"TREE_DENSITY_AGENT","task":"TREE_DENSITY_TASK"},
                      {"name":"TREE_ANOMALY_AGENT","task":"TREE_ANOMALY_TASK"},
                      {"name":"TREE_KMEANS_AGENT","task":"TREE_KMEANS_TASK"}
                  ]
              }~',
              description => 'Existing tree workers plus dated semantic history retrieval.'
          );
      END;

      /

      -- PL/SQL procedure successfully completed.



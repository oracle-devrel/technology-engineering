      -- Elapsed: 00:00:00.112\r

      -- 13 rows selected."
    languageId: oracle-sql
  - kind: 2
    value: "\r

      --  we can add this conversation history we need tools\r

      SELECT created,\r

      \       profile_name,\r

      \       DBMS_LOB.SUBSTR(prompt, 500, 1) AS YOUR_UI_QUESTION,\r

      \       DBMS_LOB.SUBSTR(prompt_response, 500, 1) AS ANSWER\r

      FROM user_cloud_ai_conversation_prompts\r

      WHERE prompt_action = 'AGENT'\r

      ORDER BY created DESC\r

      FETCH FIRST 20 ROWS ONLY;\r

      \r


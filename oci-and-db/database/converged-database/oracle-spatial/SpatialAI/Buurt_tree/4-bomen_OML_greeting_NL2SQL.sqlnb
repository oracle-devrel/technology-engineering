  - kind: 2
    value: "---answers \r

      SELECT team_name, agent_name, task_name,\r

      \       DBMS_LOB.SUBSTR(result, 500, 1) AS answer\r

      FROM user_ai_agent_task_history\r

      WHERE result IS NOT NULL\r

      ORDER BY start_date DESC\r

      FETCH FIRST 10 ROWS ONLY;\r

      \r

      --
      TEAM_NAME             AGENT_NAME              TASK_NAME                    \
      ANSWER                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               \
      \r


  - kind: 2
    value: "SELECT t.source_tree_number,\r

      \       t.source_record_id,\r

      \       t.geometry.sdo_srid AS srid\r

      FROM bomen_trees t\r

      WHERE t.source_tree_number = 5811455\r

      \   OR t.source_record_id = 5811455;\r

      \r

      -- SOURCE_TREE_NUMBER SOURCE_RECORD_ID  SRID \r

      -- ------------------ ---------------- ----- \r

      --                 52          5811455 28992 \r

      \r


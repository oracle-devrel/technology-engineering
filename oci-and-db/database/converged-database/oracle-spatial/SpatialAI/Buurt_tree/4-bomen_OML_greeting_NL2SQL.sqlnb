      -- Elapsed: 00:00:00.030
    languageId: oracle-sql
  - kind: 2
    value: "-- TREE_NL2SQL_TASK\r

      DECLARE\r

      \    v_instruction CLOB := q'|\r

      Answer the user's factual tree or neighbourhood question: {query}\r

      \r

      1. Call TREE_SQL_CONTEXT_TOOL first to check the requested object.\r

      2. If the object is unavailable, explain that clearly. Do not invent
      data.\r

      3. Otherwise call TREE_NL2SQL_TOOL exactly once.\r

      4. For questions selecting individual trees or neighbourhoods, request
      structured result rows with GEOJSON for every selected feature. This
      includes lists and nearest-tree questions even when the user does not say
      \"map\".\r

      5. Preserve the requested filters, number of rows, ordering, and reference
      tree or neighbourhood .\r

      6. For saved analysis results, use one explicit RUN_ID; never mix runs.\r

      7. Report only values returned by the tool. Do not claim the browser map
      rendered unless the application confirms it.\r

      |';\r

      \    v_attributes CLOB;\r

      BEGIN\r

      \    SELECT JSON_OBJECT(\r

      \               'instruction' VALUE v_instruction,\r

      \               'tools' VALUE JSON_ARRAY(\r

      \                   'TREE_SQL_CONTEXT_TOOL',\r

      \                   'TREE_NL2SQL_TOOL'\r

      \               ) FORMAT JSON\r

      \               RETURNING CLOB\r

      \           )\r

      \      INTO v_attributes\r

      \      FROM dual;\r

      \r

      \    DBMS_CLOUD_AI_AGENT.DROP_TASK(\r

      \        'TREE_NL2SQL_TASK', force => TRUE\r

      \    );\r

      \r

      \    DBMS_CLOUD_AI_AGENT.CREATE_TASK(\r

      \        task_name   => 'TREE_NL2SQL_TASK',\r

      \        attributes  => v_attributes,\r

      \        description => 'Answers factual SQL and spatial questions.'\r

      \    );\r

      END;\r

      /\r

      -- PL/SQL procedure successfully completed.\r

      \r

      -- Elapsed: 00:00:00.053"
    languageId: oracle-sql
  - kind: 2
    value: >-
      BEGIN
          DBMS_CLOUD_AI_AGENT.DROP_AGENT('TREE_NL2SQL_AGENT', force => TRUE);
          DBMS_CLOUD_AI_AGENT.CREATE_AGENT(
              agent_name => 'TREE_NL2SQL_AGENT',
              attributes => q'~{
                  "profile_name":"OCI_GROK_4_3_BOMEN_BURRT_PROFILE",
                  "role":"You answer factual Den Haag tree and neighbourhood questions using TREE_NL2SQL_TASK. Query only existing approved objects. Use explicit RUN_IDs for saved analysis results. Never train a model or claim a tree is unhealthy."
              }~',
              description => 'Factual SQL worker for existing tree-project objects.'
          );
      END;

      /

      -- PL/SQL procedure successfully completed.


      -- Elapsed: 00:00:00.030
    languageId: oracle-sql
  - kind: 1
    value: |
      ## 5. Extend the one existing supervisor team

      Run only after both new agents and all four existing workers are present.
      This replaces TREE_DENSITY_MAP_TEAM in place. It does not create another
      team and does not drop any saved result rows.
    languageId: markdown
  - kind: 2
    value: >
      BEGIN
          DBMS_CLOUD_AI_AGENT.DROP_TEAM('TREE_DENSITY_MAP_TEAM', force => TRUE);
          DBMS_CLOUD_AI_AGENT.DROP_AGENT(
              'TREE_DENSITY_SUPERVISOR', force => TRUE
          );
          DBMS_CLOUD_AI_AGENT.CREATE_AGENT(
              agent_name => 'TREE_DENSITY_SUPERVISOR',
              attributes => q'~{
                  "profile_name":"OCI_GROK_4_3_BOMEN_BURRT_PROFILE",
                  "role":"You supervise one Den Haag trees and green-neighbourhood team. Route a greeting or request for examples to TREE_GREETING_AGENT. Route open-ended data-quality candidate discovery to TREE_DISCOVERY_AGENT. Route a new neighbourhood density calculation or green-percentage threshold to TREE_DENSITY_AGENT. Route a new one-class SVM flagging request to TREE_ANOMALY_AGENT. Route a new K-means tree-grouping request to TREE_KMEANS_AGENT. Route factual questions over existing source tables, views, or saved analysis results to TREE_NL2SQL_AGENT, including questions joining saved SVM and K-means results. Do not send a new model calculation to NL2SQL. Do not send a factual saved-result query to an OML worker merely because it mentions its model. Ask a focused clarification when intent or run selection is unclear. Use measured outputs only. Do not claim a flag or cluster diagnoses tree health, and do not claim the browser map rendered unless the application confirms it.",
                  "supervisor":true
              }~',
              description => 'Routes greeting, SQL, discovery, density, SVM, and K-means.'
          );
          DBMS_CLOUD_AI_AGENT.CREATE_TEAM(
              team_name => 'TREE_DENSITY_MAP_TEAM',
              attributes => q'~{
                  "process":"sequential",
                  "supervisor_agent":"TREE_DENSITY_SUPERVISOR",
                  "agents":[
                      {"name":"TREE_GREETING_AGENT","task":"TREE_GREETING_TASK"},
                      {"name":"TREE_NL2SQL_AGENT","task":"TREE_NL2SQL_TASK"},
                      {"name":"TREE_DISCOVERY_AGENT","task":"TREE_DISCOVERY_TASK"},
                      {"name":"TREE_DENSITY_AGENT","task":"TREE_DENSITY_TASK"},
                      {"name":"TREE_ANOMALY_AGENT","task":"TREE_ANOMALY_TASK"},
                      {"name":"TREE_KMEANS_AGENT","task":"TREE_KMEANS_TASK"}
                  ]
              }~',
              description => 'Routes tree and neighbourhood questions to greeting, SQL, discovery, density, SVM, and K-means workers.'
          );
      END;

      /


      -- PL/SQL procedure successfully completed.


      -- Elapsed: 00:00:01.557

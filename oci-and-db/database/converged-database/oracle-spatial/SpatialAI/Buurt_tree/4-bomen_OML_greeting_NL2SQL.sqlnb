    languageId: oracle-sql
  - kind: 2
    value: "CREATE OR REPLACE FUNCTION tree_greeting_fn\r

      \    RETURN CLOB\r

      AS\r

      BEGIN\r

      \    RETURN TO_CLOB(q'~{\r

      \      \"intro\":\"Hi! I help explore Den Haag tree and
      green-neighbourhood data with SQL and Oracle Machine Learning. Here are
      the original datasets and example questions.\",\r

      \      \"original_datasets\":[\r

      \        {\r

      \          \"table\":\"BOMEN_TREES\",\r

      \          \"column_count\":26,\r

      \          \"columns\":[\"SOURCE_TREE_NUMBER\",\"SPECIES_COMMON_NAME\",\"\
      SRT_WETENS\",\"TREE_AGE\",\"AGE_CLASS_CATEGORY\",\"TRUNK_DIAMETER\",\"OWN\
      ER\",\"MANAGER\",\"PRUNING_FORM\",\"MONUMENTAL_FIELD\",\"SOURCE_WORK_PACK\
      AGE_CODE\",\"SOURCE_WORK_PACKAGE\",\"GROWING_SITE\",\"STREET_NAME\",\"CIT\
      Y_DISTRICT\",\"COUNTER\",\"SOURCE_RECORD_ID\",\"DISTRICT_NAME\",\"NEIGHBO\
      URHOOD\",\"WGS84_LONGITUDE\",\"WGS84_LATITUDE\",\"SOURCE_PROJECTED_X_COOR\
      DINATE\",\"SOURCE_PROJECTED_Y_COORDINATE\",\"SOURCE_TEXT_IEPVAK_OMS\",\"S\
      OURCE_CODE_PKBZ\",\"GEOMETRY\"]\r

      \        },\r

      \        {\r

      \          \"table\":\"GEZOND_GREEN_NEIGHBOURHOOD\",\r

      \          \"column_count\":8,\r

      \          \"columns\":[\"NEIGHBOURHOOD_CODE\",\"NEIGHBORHOOD_NAME\",\"MU\
      NICIPALITY_CODE\",\"MUNICIPALITY_NAME\",\"YEAR\",\"PERCENTAGE\",\"GEOMETRY\
      \",\"ID\"]\r

      \        }\r

      \      ],\r

      \      \"sql_capabilities\":\"Ask ordinary SQL and spatial questions about
      available data, including distance and topological relationships.\",\r

      \      \"examples\":[\r

      \        {\"question\":\"Hi, which questions can I ask?\"},\r

      \        {\"question\":\"How many records are in BOMEN_TREES?\"},\r

      \        {\"question\":\"How many neighbourhoods are in the available
      data?\"},\r

      \        {\"question\":\"Show me 11 trees close to tree ID 5811455,
      including 5811455.\"},\r

      \        {\"question\":\"Which Quercus robur tree records have unusual age
      and trunk-diameter classes?\"},\r

      \        {\"question\":\"Which neighbourhoods have the highest tree
      density?\"},\r

      \        {\"question\":\"Which five Den Haag neighbourhoods have the
      highest tree density despite having less than 30% green area?\"},\r

      \        {\"question\":\"Group Quercus robur trees into three clusters by
      age and trunk-diameter class.\"},\r

      \        {\"question\":\"Which questions did I ask you?\"},\r

      \        {\"question\":\"Which three neighbourhoods contain the most
      recorded trees? Return their counts and show those three neighbourhood
      polygons on the map.\"},\r

      \        {\"question\":\"Which neighbourhood contains the most recorded
      trees? Show only that neighbourhood’s polygon on the map.\"}\r

      \      ],\r

      \      \"note\":\"These are examples, not a complete question list. SQL
      can answer broader questions over approved objects that exist. Ask the
      supervisor to run density, SVM, or K-means for a new analysis. Saved
      result views omit geometry; spatial tables or saved GeoJSON support maps.
      A model flag is a record for review, not a health diagnosis.\"\r

      \    }~');\r

      END tree_greeting_fn;\r

      /\r

      -- PL/SQL procedure successfully completed.\r

      \r

      -- Elapsed: 00:00:00.141"
    languageId: oracle-sql
  - kind: 2
    value: >-
      BEGIN
          DBMS_CLOUD_AI_AGENT.DROP_TOOL('TREE_GREETING_TOOL', force => TRUE);
          DBMS_CLOUD_AI_AGENT.CREATE_TOOL(
              tool_name => 'TREE_GREETING_TOOL',
              attributes => q'~{
                  "function":"TREE_GREETING_FN",
                  "instruction":"Return the fixed, reviewed Den Haag tree greeting with the original dataset column names and example questions. Do not calculate or invent values."
              }~',
              description => 'Fixed original-dataset and example-question guide.'
          );
      END;

      /



      -- PL/SQL procedure successfully completed.


      -- Elapsed: 00:00:00.094
    languageId: oracle-sql
  - kind: 2
    value: >-
      -- DBMS_CLOUD_AI_AGENT.CREATE_TASK: TREE_GREETING_TASK

      DECLARE
          v_instruction CLOB := q'|
      The user greeted the tree team: {query}

      1. Call TREE_GREETING_TOOL exactly once.

      2. Introduce both original datasets and list every returned column name.

      3. Give the returned example questions with their table/view and columns.

      4. Say that the examples are not a limit on NL2SQL questions.

      5. Do not claim that any analysis or map ran during this greeting.

      |';
          v_attributes CLOB;
      BEGIN
          SELECT JSON_OBJECT(
              'instruction' VALUE v_instruction,
              'tools' VALUE JSON_ARRAY('TREE_GREETING_TOOL') FORMAT JSON
              RETURNING CLOB
          ) INTO v_attributes FROM dual;
          DBMS_CLOUD_AI_AGENT.DROP_TASK('TREE_GREETING_TASK', force => TRUE);
          DBMS_CLOUD_AI_AGENT.CREATE_TASK(
              task_name => 'TREE_GREETING_TASK',
              attributes => v_attributes,
              description => 'Introduces original datasets, columns, and examples.'
          );
      END;

      /


      -- PL/SQL procedure successfully completed.


      -- Elapsed: 00:00:00.094
    languageId: oracle-sql
  - kind: 2
    value: >-
      BEGIN
          DBMS_CLOUD_AI_AGENT.DROP_AGENT('TREE_GREETING_AGENT', force => TRUE);
          DBMS_CLOUD_AI_AGENT.CREATE_AGENT(
              agent_name => 'TREE_GREETING_AGENT',
              attributes => q'~{
                  "profile_name":"OCI_GROK_4_3_BOMEN_BURRT_PROFILE",
                  "role":"You are the greeting worker for the Den Haag tree team. Follow TREE_GREETING_TASK and use the fixed greeting tool output. Do not inspect the schema or run a model for a greeting."
              }~',
              description => 'Fixed introduction to the tree demo.'
          );
      END;

      /


      -- PL/SQL procedure successfully completed.


      -- Elapsed: 00:00:00.094
    languageId: oracle-sql
  - kind: 1
    value: |
      ## 2. Dedicated NL2SQL profile

      This profile is separate from OCI_GROK_4_3_BOMEN_BURRT_PROFILE and the
      district profile. Its enforced object list contains only tree-project
      tables and views that currently exist. The context tool below updates
      the object list when a worker creates another result object.
    languageId: markdown
  - kind: 2
    value: >
      DECLARE
          v_objects CLOB;
          v_attributes CLOB;
      BEGIN
          SELECT JSON_ARRAYAGG(
                     JSON_OBJECT(
                         'owner' VALUE SYS_CONTEXT('USERENV','CURRENT_SCHEMA'),
                         'name' VALUE object_name
                     ) ORDER BY object_name RETURNING CLOB
                 ) INTO v_objects
          FROM user_objects
          WHERE object_type IN ('TABLE','VIEW')
            AND object_name IN (
                'BOMEN_TREES', 'BOMEN_TREES_V',
                'GEZOND_GREEN_NEIGHBOURHOOD',
                'GEZOND_GREEN_NEIGHBOURHOOD_V',
                'TREE_DENSITY_RESULTS', 'TREE_DENSITY_RESULTS_V',
                'TREE_ANOMALY_RESULTS', 'TREE_ANOMALY_RESULTS_V',
                'TREE_ANOMALY_RUNS',
                'TREE_KMEANS_RESULTS', 'TREE_KMEANS_RESULTS_V',
                'TREE_KMEANS_RUNS', 'AGENT_MAP_RESULTS'
            );
          IF v_objects IS NULL THEN
              RAISE_APPLICATION_ERROR(-20401,
                  'No approved tree-project table or view exists.');
          END IF;
          SELECT JSON_OBJECT(
              'provider' VALUE 'oci',
              'credential_name' VALUE 'GENAI_CRED',
              'model' VALUE 'xai.grok-4.3',
              'object_list' VALUE v_objects FORMAT JSON,
              'enforce_object_list' VALUE 'false' FORMAT JSON,
              'additional_instructions' VALUE
                  'Use read-only SELECT statements over the listed existing tree-project objects. For saved analysis results, choose an explicit RUN_ID; never mix runs. Join tree results on SOURCE_RECORD_ID only after filtering each result to one RUN_ID. Preserve table grain: a tree row is not a neighbourhood row. Do not claim that a K-means cluster or SVM flag diagnoses tree health. Do not invent missing objects or rows. For map requests, use a spatial table with GEOMETRY and return GEOJSON only for matching rows; nonspatial _V views omit GEOMETRY. Transform to SRID 4326 before GeoJSON when needed.'
              RETURNING CLOB
          ) INTO v_attributes FROM dual;
          DBMS_CLOUD_AI.DROP_PROFILE(
              profile_name => 'OCI_GROK_4_3_TREE_NL2SQL_PROFILE',
              force => TRUE
          );
          DBMS_CLOUD_AI.CREATE_PROFILE(
              profile_name => 'OCI_GROK_4_3_TREE_NL2SQL_PROFILE',
              attributes => v_attributes,
              description => 'Read-only SQL over existing tree-project objects.'
          );
      END;

      /


      -- PL/SQL procedure successfully completed.


      -- Elapsed: 00:00:00.476
    languageId: oracle-sql
  - kind: 2
    value: "\r

      -- make sure that attribute_value  is false\r

      \r

      BEGIN\r

      \    DBMS_CLOUD_AI.SET_ATTRIBUTE(\r

      \        profile_name    => 'OCI_GROK_4_3_TREE_NL2SQL_PROFILE',\r

      \        attribute_name  => 'enforce_object_list',\r

      \        attribute_value => 'false'\r

      \    );\r

      END;\r

      /"
    languageId: oracle-sql
  - kind: 1
    value: |
      ## 3. Live object context for NL2SQL

      This tool checks object availability before SQL. It refreshes only the
      new NL2SQL profile's approved object list, so result tables/views created
      later by density, SVM, or K-means are available on the next question.
      It does not create data tables, model results, or another team.
    languageId: markdown
  - kind: 2
    value: >+
      CREATE OR REPLACE FUNCTION tree_sql_context_fn (
          p_object_name IN VARCHAR2 DEFAULT NULL
      ) RETURN CLOB AS
          PRAGMA AUTONOMOUS_TRANSACTION;
          v_name VARCHAR2(128) := UPPER(TRIM(p_object_name));
          v_objects CLOB;
          v_count NUMBER;
          v_type VARCHAR2(30);
          v_hint VARCHAR2(300);
          v_response CLOB;
      BEGIN
          IF v_name IS NOT NULL AND
             NOT REGEXP_LIKE(v_name, '^[A-Z][A-Z0-9_$#]{0,127}$') THEN
              RAISE_APPLICATION_ERROR(-20402, 'Invalid object name.');
          END IF;

          SELECT JSON_ARRAYAGG(
                     JSON_OBJECT(
                         'owner' VALUE SYS_CONTEXT('USERENV','CURRENT_SCHEMA'),
                         'name' VALUE object_name
                     ) ORDER BY object_name RETURNING CLOB
                 ) INTO v_objects
          FROM user_objects
          WHERE object_type IN ('TABLE','VIEW')
            AND object_name IN (
                'BOMEN_TREES', 'BOMEN_TREES_V',
                'GEZOND_GREEN_NEIGHBOURHOOD',
                'GEZOND_GREEN_NEIGHBOURHOOD_V',
                'TREE_DENSITY_RESULTS', 'TREE_DENSITY_RESULTS_V',
                'TREE_ANOMALY_RESULTS', 'TREE_ANOMALY_RESULTS_V',
                'TREE_ANOMALY_RUNS',
                'TREE_KMEANS_RESULTS', 'TREE_KMEANS_RESULTS_V',
                'TREE_KMEANS_RUNS', 'AGENT_MAP_RESULTS'
            );
          IF v_objects IS NULL THEN
              RAISE_APPLICATION_ERROR(-20403,
                  'No approved tree-project object is available.');
          END IF;
          DBMS_CLOUD_AI.SET_ATTRIBUTE(
              profile_name => 'OCI_GROK_4_3_TREE_NL2SQL_PROFILE',
              attribute_name => 'object_list',
              attribute_value => v_objects
          );
          COMMIT;

          IF v_name IS NULL THEN
              SELECT JSON_OBJECT(
                  'status' VALUE 'success',
                  'available_objects' VALUE v_objects FORMAT JSON,
                  'note' VALUE 'Use only available approved objects. Run an existing analysis worker to create a missing result.'
                  RETURNING CLOB
              ) INTO v_response FROM dual;
              RETURN v_response;
          END IF;

          SELECT COUNT(*), MAX(object_type)
          INTO v_count, v_type
          FROM user_objects
          WHERE object_name = v_name
            AND object_type IN ('TABLE','VIEW')
            AND v_name IN (
                'BOMEN_TREES', 'BOMEN_TREES_V',
                'GEZOND_GREEN_NEIGHBOURHOOD',
                'GEZOND_GREEN_NEIGHBOURHOOD_V',
                'TREE_DENSITY_RESULTS', 'TREE_DENSITY_RESULTS_V',
                'TREE_ANOMALY_RESULTS', 'TREE_ANOMALY_RESULTS_V',
                'TREE_ANOMALY_RUNS',
                'TREE_KMEANS_RESULTS', 'TREE_KMEANS_RESULTS_V',
                'TREE_KMEANS_RUNS', 'AGENT_MAP_RESULTS'
            );
          IF v_count = 0 THEN
              IF v_name IN ('TREE_DENSITY_RESULTS',
                            'TREE_DENSITY_RESULTS_V') THEN
                  v_hint := 'Ask TREE_DENSITY_AGENT to calculate density; its tool prepares the result table and view.';
              ELSIF v_name IN ('TREE_ANOMALY_RESULTS',
                               'TREE_ANOMALY_RESULTS_V',
                               'TREE_ANOMALY_RUNS') THEN
                  v_hint := 'Ask TREE_ANOMALY_AGENT to run the SVM pilot; its tool prepares saved anomaly results.';
              ELSIF v_name IN ('TREE_KMEANS_RESULTS',
                               'TREE_KMEANS_RESULTS_V',
                               'TREE_KMEANS_RUNS') THEN
                  v_hint := 'Ask TREE_KMEANS_AGENT to run the K-means pilot; its tool prepares saved clusters.';
              ELSIF v_name IN ('BOMEN_TREES','GEZOND_GREEN_NEIGHBOURHOOD') THEN
                  v_hint := 'Run the existing source translation workflow first.';
              ELSIF v_name IN ('BOMEN_TREES_V',
                               'GEZOND_GREEN_NEIGHBOURHOOD_V') THEN
                  v_hint := 'Ask TREE_DENSITY_AGENT; its setup prepares the nonspatial source views.';
              ELSE
                  v_hint := 'This object is absent or outside the approved tree-project SQL scope.';
              END IF;
          ELSE
              v_hint := 'The approved object exists and can be queried.';
          END IF;
          SELECT JSON_OBJECT(
              'status' VALUE 'success',
              'object_name' VALUE v_name,
              'exists' VALUE CASE WHEN v_count > 0 THEN 'true'
                                  ELSE 'false' END FORMAT JSON,
              'object_type' VALUE v_type,
              'next_step' VALUE v_hint
              RETURNING CLOB
          ) INTO v_response FROM dual;
          RETURN v_response;
      END tree_sql_context_fn;

      /


      -- Function TREE_SQL_CONTEXT_FN compiled


      -- Elapsed: 00:00:00.099

    languageId: oracle-sql
  - kind: 2
    value: >
      BEGIN
          DBMS_CLOUD_AI_AGENT.DROP_TOOL('TREE_SQL_CONTEXT_TOOL', force => TRUE);
          DBMS_CLOUD_AI_AGENT.CREATE_TOOL(
              tool_name => 'TREE_SQL_CONTEXT_TOOL',
              attributes => q'~{
                  "function":"TREE_SQL_CONTEXT_FN",
                  "instruction":"Check whether a requested tree-project table or view currently exists and refresh the dedicated NL2SQL profile to the approved objects that currently exist. For a missing object, return the relevant existing analysis worker or translation workflow; do not invent data.",
                  "tool_inputs":[
                      {"name":"p_object_name","description":"Optional exact table or view name. Null lists the available approved tree-project objects."}
                  ]
              }~',
              description => 'Live tree-object availability and NL2SQL profile refresh.'
          );
      END;

      /


      -- PL/SQL procedure successfully completed.


      -- Elapsed: 00:00:00.034
    languageId: oracle-sql
  - kind: 1
    value: |
      ## 4. NL2SQL tool, task, and worker

      The SQL tool follows the district-agent pattern but uses its own profile.
      It answers factual questions over existing objects; it never trains an
      OML model or creates analysis results.
    languageId: markdown
  - kind: 2
    value: "-- TREE_NL2SQL_TOOL\r

      DECLARE\r

      \    v_instruction CLOB := q'|\r

      Answer factual, read-only questions using the available tree and
      neighbourhood tables and views.\r

      \r

      \r

      1. Call TREE_SQL_CONTEXT_TOOL first. Pass an object name only if the user
      supplied an exact table or view name; otherwise pass null and inspect the
      available objects.\r

      2. If a user-named exact object is confirmed missing, explain that. For
      ordinary questions, choose from the available objects and continue to
      TREE_NL2SQL_TOOL. Do not invent data.\r

      3. Get GEOMETRY from the spatial source table. Convert it using
      SDO_UTIL.TO_GEOJSON(SDO_CS.TRANSFORM(GEOMETRY, 4326)).\r

      4. For nearest-tree questions, include the reference tree when requested
      and return the requested total number of trees.\r

      5. Counts and other aggregate answers do not need GEOJSON.\r

      6. This tool only queries existing data. Do not start density, SVM, or
      K-means calculations; their agents handle those requests. Never make up
      rows. For selected map features, return database rows with GEOJSON so the
      application can plot them; coordinates written in the chat answer are not
      map data.\r

      |';\r

      \    v_attributes CLOB;\r

      BEGIN\r

      \    SELECT JSON_OBJECT(\r

      \               'tool_type' VALUE 'SQL',\r

      \               'instruction' VALUE v_instruction,\r

      \               'tool_params' VALUE JSON_OBJECT(\r

      \                   'profile_name' VALUE
      'OCI_GROK_4_3_TREE_NL2SQL_PROFILE'\r

      \               )\r

      \               RETURNING CLOB\r

      \           )\r

      \      INTO v_attributes\r

      \      FROM dual;\r

      \r

      \    DBMS_CLOUD_AI_AGENT.DROP_TOOL(\r

      \        'TREE_NL2SQL_TOOL', force => TRUE\r

      \    );\r

      \r

      \    DBMS_CLOUD_AI_AGENT.CREATE_TOOL(\r

      \        tool_name   => 'TREE_NL2SQL_TOOL',\r

      \        attributes  => v_attributes,\r

      \        description => 'Read-only SQL with GeoJSON for selected spatial
      rows.'\r

      \    );\r

      END;\r

      /\r

      \r

      -- PL/SQL procedure successfully completed.\r

      \r

      -- Elapsed: 00:00:00.098"
    languageId: oracle-sql
  - kind: 2
    value: |-
      -- BEGIN
      --     DBMS_CLOUD_AI_AGENT.DROP_TOOL('TREE_NL2SQL_TOOL', force => TRUE);
      --     DBMS_CLOUD_AI_AGENT.CREATE_TOOL(
      --         tool_name => 'TREE_NL2SQL_TOOL',
      --         attributes => q'~{
      --             "tool_type":"SQL",
      --             "tool_params":{"profile_name":"OCI_GROK_4_3_TREE_NL2SQL_PROFILE"},
      --             "instruction":"Answer factual read-only questions over currently available approved tree-project tables and views. Preserve filters and RUN_IDs. Do not run a model or create a table. Return actual rows only. For map requests use a spatial table and include matching GEOJSON; nonspatial views omit geometry."
      --         }~',
      --         description => 'Factual SQL over existing tree-project objects.'
      --     );
      -- END;
      -- /
      -- -- PL/SQL procedure successfully completed.

      -- -- Elapsed: 00:00:00.034
    languageId: oracle-sql
  - kind: 2
    value: >
      -- -- DBMS_CLOUD_AI_AGENT.CREATE_TASK: TREE_NL2SQL_TASK

      -- DECLARE

      --     v_instruction CLOB := q'|

      -- Answer this factual data question: {query}

      -- 1. Call TREE_SQL_CONTEXT_TOOL first. Pass the named table/view if the

      --    user names one; otherwise pass null. This refreshes the SQL profile.

      -- 2. If the requested object is missing or outside scope, do not call
      SQL.

      --    Explain the returned next step. Never invent a table or value.

      -- 3. For a supported factual question, call TREE_NL2SQL_TOOL to run a

      --    read-only SQL query over available approved objects.

      -- 4. When reading saved density, SVM, or K-means results, use an explicit

      --    RUN_ID. Do not combine different runs accidentally.

      -- 5. Join tree results by SOURCE_RECORD_ID only after selecting one run

      --    from each result. A neighbourhood is a different row level; use a

      --    valid spatial relationship for tree-to-neighbourhood questions.

      -- 6. Report only actual query rows. Do not interpret a model flag as poor

      --    health or a K-means cluster as an anomaly.

      -- 7. A request to calculate new density, run SVM, or run K-means belongs

      --    to its specialist worker, not this SQL task.

      -- 8. Do not claim that the browser map rendered unless confirmed.

      -- |';

      --     v_attributes CLOB;

      -- BEGIN

      --     SELECT JSON_OBJECT(

      --         'instruction' VALUE v_instruction,

      --         'tools' VALUE JSON_ARRAY(

      --             'TREE_SQL_CONTEXT_TOOL', 'TREE_NL2SQL_TOOL'

      --         ) FORMAT JSON

      --         RETURNING CLOB

      --     ) INTO v_attributes FROM dual;

      --     DBMS_CLOUD_AI_AGENT.DROP_TASK('TREE_NL2SQL_TASK', force => TRUE);

      --     DBMS_CLOUD_AI_AGENT.CREATE_TASK(

      --         task_name => 'TREE_NL2SQL_TASK',

      --         attributes => v_attributes,

      --         description => 'Answers factual questions from available tree
      tables and views.'

      --     );


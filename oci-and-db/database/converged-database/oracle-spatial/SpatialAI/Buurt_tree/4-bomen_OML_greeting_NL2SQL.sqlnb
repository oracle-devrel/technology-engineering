      --         {"question":"Which neighbourhood contains tree ID 5811455?","tables_or_views":["BOMEN_TREES","GEZOND_GREEN_NEIGHBOURHOOD"],"columns":["SOURCE_RECORD_ID","SOURCE_TREE_NUMBER","GEOMETRY","NEIGHBORHOOD_NAME"]},
      --         {"question":"Which tree species are most common?No spatial only discovery question","tables_or_views":["BOMEN_TREES_V"],"columns":["SRT_WETENS","SPECIES_COMMON_NAME","SOURCE_RECORD_ID"]},

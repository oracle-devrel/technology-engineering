      \    WHERE team_name = 'TREE_DENSITY_MAP_TEAM'\r

      \    ORDER BY start_date DESC\r

      \    FETCH FIRST 10 ROWS ONLY\r

      ) h\r

      LEFT JOIN user_ai_agent_task_history t\r

      \    ON t.team_exec_id = h.team_exec_id\r

      ORDER BY h.start_date DESC, t.start_date;\r


    languageId: oracle-sql
  - kind: 2
    value: "SELECT h.start_date AS team_started,\r

      \       h.state AS run_state,\r

      \       DBMS_LOB.SUBSTR(p.prompt, 300, 1) AS question,\r

      \       DBMS_LOB.SUBSTR(p.prompt_response, 500, 1) AS answer,\r

      \       (SELECT LISTAGG(t.agent_name || ' (' || t.state || ')', ', ')\r

      \               WITHIN GROUP (ORDER BY t.start_date)\r

      \          FROM user_ai_agent_task_history t\r

      \         WHERE t.team_exec_id = h.team_exec_id\r

      \           AND t.agent_name <> 'TREE_DENSITY_SUPERVISOR'\r

      \       ) AS workers\r

      FROM user_ai_agent_team_history h\r

      OUTER APPLY (\r

      \    SELECT p.prompt, p.prompt_response\r

      \    FROM user_cloud_ai_conversation_prompts p\r

      \    WHERE p.conversation_id = h.conversation_id\r

      \      AND p.prompt_action = 'AGENT'\r

      \      AND p.created >= h.start_date\r

      \      AND p.created <= h.end_date\r

      \    ORDER BY p.created DESC\r

      \    FETCH FIRST 1 ROW ONLY\r

      ) p\r

      WHERE h.team_name = 'TREE_DENSITY_MAP_TEAM'\r

      ORDER BY h.start_date DESC\r

      FETCH FIRST 20 ROWS ONLY;\r

      \r

      \r


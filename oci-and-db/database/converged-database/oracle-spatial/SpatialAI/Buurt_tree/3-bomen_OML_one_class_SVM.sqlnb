      \r

      \    SELECT COUNT(*) INTO v_count FROM TREE_ANOMALY_RUNS;\r

      \    DBMS_OUTPUT.PUT_LINE('TREE_ANOMALY_RUNS: ' || v_count);\r

      \r

      \    SELECT COUNT(*) INTO v_count FROM TREE_ANOMALY_SETTINGS;\r


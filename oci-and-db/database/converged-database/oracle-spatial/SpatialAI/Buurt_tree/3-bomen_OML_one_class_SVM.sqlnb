  - kind: 2
    value: |
      -- Check that the Agent-created storage, views, and model exist.
      SELECT object_name, object_type, status
      FROM user_objects
      WHERE object_name IN (
          'TREE_ANOMALY_RESULTS', 'TREE_ANOMALY_RESULTS_V',
          'TREE_ANOMALY_RUNS', 'TREE_ANOMALY_SETTINGS',
          'TREE_ANOMALY_INPUT_V', 'TREE_QUERCUS_OCSVM_MODEL',
          'AGENT_MAP_RESULTS'
      )
      ORDER BY object_name;


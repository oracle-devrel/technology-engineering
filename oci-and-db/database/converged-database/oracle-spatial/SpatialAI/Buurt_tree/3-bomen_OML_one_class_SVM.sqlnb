    languageId: oracle-sql
  - kind: 2
    value: |
      -- Map-ready flagged tree points for the latest run (preview 20).
      SELECT SOURCE_RECORD_ID, SPECIES_NAME, TREE_AGE, TRUNK_DIAMETER,
             ANOMALY_PROBABILITY,
             SDO_UTIL.TO_GEOJSON(SDO_CS.TRANSFORM(GEOMETRY, 4326)) AS GEOJSON
      FROM TREE_ANOMALY_RESULTS
      WHERE RUN_ID = (
          SELECT RUN_ID FROM TREE_ANOMALY_RUNS
          ORDER BY CREATED_AT DESC FETCH FIRST 1 ROW ONLY
      )
        AND ANOMALY_FLAG = 1
        AND GEOMETRY IS NOT NULL
      ORDER BY ANOMALY_PROBABILITY DESC, SOURCE_RECORD_ID
      FETCH FIRST 20 ROWS ONLY;
    languageId: oracle-sql
  - kind: 2
    value: >
      -- A second call should reuse the same RUN_ID without retraining.

      SELECT DBMS_CLOUD_AI_AGENT.RUN_TOOL(
                 tool_name => 'TREE_ANOMALY_TOOL',
                 input => '{"P_SPECIES":"Quercus robur","P_OUTLIER_RATE":0.01,"P_FORCE_REFRESH":"N"}'
             ) AS TOOL_RESULT
      FROM dual;
    languageId: oracle-sql
  - kind: 2
    value: >
      -- End-to-end anomaly routing test in the shared team.

      DECLARE
          v_conversation_id VARCHAR2(4000);
          v_response CLOB;
      BEGIN
          v_conversation_id := DBMS_CLOUD_AI.CREATE_CONVERSATION();
          v_response := DBMS_CLOUD_AI_AGENT.RUN_TEAM(
              team_name   => 'TREE_DENSITY_MAP_TEAM',
              user_prompt => 'Which Quercus robur tree records have unusual age and trunk-diameter classes? Give their IDs and run ID.',
              params      => '{"conversation_id":"' || v_conversation_id || '"}'
          );
          DBMS_OUTPUT.PUT_LINE(DBMS_LOB.SUBSTR(v_response, 4000, 1));
      END;

      /
    languageId: oracle-sql
  - kind: 2
    value: >
      -- Density regression test: the same supervisor should choose the

      -- density worker, not the anomaly worker.

      DECLARE
          v_conversation_id VARCHAR2(4000);
          v_response CLOB;
      BEGIN
          v_conversation_id := DBMS_CLOUD_AI.CREATE_CONVERSATION();
          v_response := DBMS_CLOUD_AI_AGENT.RUN_TEAM(
              team_name   => 'TREE_DENSITY_MAP_TEAM',
              user_prompt => 'Which Den Haag neighbourhood has the highest tree density?',
              params      => '{"conversation_id":"' || v_conversation_id || '"}'
          );
          DBMS_OUTPUT.PUT_LINE(DBMS_LOB.SUBSTR(v_response, 4000, 1));
      END;

      /
    languageId: oracle-sql
  - kind: 2
    value: |
      -- Verify the supervisor's worker choices for the last two team runs.
      -- Expect TREE_ANOMALY_TASK for the anomaly question and
      -- TREE_DENSITY_TASK for the density question.
      WITH last_two AS (
          SELECT team_exec_id, start_date
          FROM user_ai_agent_team_history
          WHERE team_name = 'TREE_DENSITY_MAP_TEAM'
          ORDER BY start_date DESC
          FETCH FIRST 2 ROWS ONLY
      )
      SELECT h.team_exec_id, h.start_date AS team_started,
             t.agent_name, t.task_name, t.state
      FROM last_two h
      JOIN user_ai_agent_task_history t
        ON t.team_exec_id = h.team_exec_id
      ORDER BY h.start_date DESC, t.start_date;
    languageId: oracle-sql
  - kind: 1
    value: |
      ## Next step

      Verify both supervisor routing tests and the saved flags first. Then add a map retrieval
      path to Ask Oracle that selects ANOMALY_FLAG=1 for this exact RUN_ID and
      returns GeoJSON points. The current notebook provides a map-ready SQL
      preview but does not change GET_RESPONSE. Expand beyond Quercus robur only
      after deciding how to treat species with fewer than 100 complete records.


    languageId: oracle-sql
  - kind: 2
    value: >-
      -- Latest saved run: flagged count should match the result rows.

      SELECT r.RUN_ID, r.SPECIES_NAME, r.OUTLIER_RATE,
             r.SCORED_COUNT, r.FLAGGED_COUNT,
             COUNT(CASE WHEN s.ANOMALY_FLAG = 1 THEN 1 END) AS SAVED_FLAGS
      FROM TREE_ANOMALY_RUNS r

      JOIN TREE_ANOMALY_RESULTS s ON s.RUN_ID = r.RUN_ID

      WHERE r.RUN_ID = (
          SELECT RUN_ID FROM TREE_ANOMALY_RUNS
          ORDER BY CREATED_AT DESC FETCH FIRST 1 ROW ONLY
      )

      GROUP BY r.RUN_ID, r.SPECIES_NAME, r.OUTLIER_RATE,
               r.SCORED_COUNT, r.FLAGGED_COUNT;
      -- RUN_ID                           SPECIES_NAME  OUTLIER_RATE
      SCORED_COUNT FLAGGED_COUNT SAVED_FLAGS 


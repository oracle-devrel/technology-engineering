      -- MUNICIPALITY_CODE        VARCHAR2(254 CHAR) \r

      -- MUNICIPALITY_NAME        VARCHAR2(254 CHAR) \r

      -- YEAR                     VARCHAR2(254 CHAR) \r

      -- PERCENTAGE               NUMBER             \r

      -- GEOMETRY                 MDSYS.SDO_GEOMETRY \r

      -- ID                       NUMBER   \r

      \r\n"
    languageId: oracle-sql

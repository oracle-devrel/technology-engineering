    languageId: oracle-sql
  - kind: 2
    value: "BEGIN\r

      \    translate_table_to_en(\r

      \        p_source_name  => 'GEZONDZH_GROEN_BUURT',\r

      \        p_target_name  => 'GEZOND_GREEN_NEIGHBOURHOOD',\r

      \        p_profile_name => 'OCI_GROK_4_3_BOMEN_BURRT_PROFILE'\r

      \    );\r

      END;"
    languageId: oracle-sql
  - kind: 2
    value: "DESC GEZOND_GREEN_NEIGHBOURHOOD; \r

      \r

      -- Name               Null? Type               \r

      -- ------------------ ----- ------------------ \r

      -- NEIGHBOURHOOD_CODE       VARCHAR2(254 CHAR) \r


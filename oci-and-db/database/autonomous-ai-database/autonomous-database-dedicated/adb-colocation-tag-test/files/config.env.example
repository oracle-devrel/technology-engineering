# Copy to config.env and set your values. Do not commit config.env.
# A full TNS DESCRIPTION is required because the test adds COLOCATION_TAG inside
# CONNECT_DATA. Get the descriptor for a dedicated service from the ADB-D console
# or from tnsnames.ora in the wallet.
DB_USER='TEST_CTAG'
DB_PASSWORD='replace-me'
BASE_CONNECT_STRING='(DESCRIPTION=(RETRY_COUNT=20)(RETRY_DELAY=3)(ADDRESS=(PROTOCOL=TCPS)(HOST=example.adb.oraclecloud.com)(PORT=1522))(CONNECT_DATA=(SERVICE_NAME=example_tp.adb.oraclecloud.com)))'

# Each run has one untagged CONTROL cohort and one TAGGED cohort. The script
# always uses the single tag C_TAGGED for every tagged worker. Each worker
# inserts increasing primary-key values into one indexed table.
SESSION_COUNT=32
WORKLOAD_SECONDS=60
COMMIT_EVERY=10
MAX_PARALLEL=16
RUNS=4

# Optional AWR add-on. Set to y only when Diagnostics Pack/AWR use is licensed
# and TEST_CTAG was provisioned with the AWR privileges in recreate_test_ctag.sql.
AWR=n

# Optional SQLcl location; otherwise `sql` must be on PATH.
# SQL_BIN='/path/to/sql'

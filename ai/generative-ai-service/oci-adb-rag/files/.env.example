# Autonomous AI Database wallet connection
ORACLE_DB_USERNAME=ADMIN
ORACLE_DB_PASSWORD=
ORACLE_DB_DSN=YOUR_DATABASE_high
TNS_ADMIN=C:\\path\\to\\Wallet_YOUR_DATABASE
ORACLE_WALLET_PASSWORD=

# Name of a configured local OCI profile
OCI_PROFILE=DEFAULT

# Use models available in your OCI region and tenancy
OCI_EMBEDDING_MODEL=cohere.embed-v4.0
OCI_CHAT_MODEL=cohere.command-a-03-2025

# Name of the OracleVS vector table created during ingestion
VECTOR_TABLE=KNOWLEDGE_CHUNKS

# OCI API signing profile
OCI_CONFIG_PROFILE=DEFAULT
# OCI_CONFIG_FILE=/absolute/path/to/oci/config

# Chicago is the default for both routes. The UI can switch routes at runtime.
OCI_REGION=us-chicago-1
INVOICE_INFERENCE_MODE=dac
# Optional realm-specific override, for example:
# OCI_GENAI_ENDPOINT=https://inference.generativeai.eu-frankfurt-2.oci.oraclecloud.eu
# OCI_OPENAI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
OCI_COMPARTMENT_ID=<YOUR_COMPARTMENT_OCID_HERE>

# Imported DAC: this endpoint OCID selects the actual deployed model.
INVOICE_DAC_ENDPOINT_OCID=<YOUR_GENERATIVE_AI_ENDPOINT_OCID_HERE>
# Display metadata only. Keep this pair truthful to the endpoint above; changing
# it does not change the deployed model that receives inference requests.
INVOICE_DAC_MODEL_ID=Qwen/Qwen3.6-35B-A3B
INVOICE_DAC_MODEL_LABEL=Qwen 3.6 35B A3B
# On-demand through OCI Responses API. A bearer key is simplest; when it is
# omitted, the app falls back to the OCI signing profile configured above.
CHICAGO_PROJECT_OCID=<YOUR_GENERATIVE_AI_PROJECT_OCID_HERE>
OPENAI_API_KEY_CHICAGO=<YOUR_GENERATIVE_AI_API_KEY_HERE>
# The application control binds each canonical label to its exact runtime ID.
INVOICE_ON_DEMAND_MODEL_ID=google.gemini-2.5-pro
# Supported UI alternatives: google.gemini-2.5-pro and xai.grok-4.3
# Do not add an independent label override.

# Optional inference and review tuning
INVOICE_MAX_TOKENS=16000
OCI_REQUEST_TIMEOUT=300
INVOICE_PDF_DPI=170
INVOICE_MAX_PAGES=12
INVOICE_CONFIDENCE_FLOOR=0.80
# Absolute currency-unit tolerance; 0.02 suits most two-decimal invoices.
INVOICE_MATH_TOLERANCE=0.02
OCI_USE_JSON_SCHEMA=true

# Copy to .env and fill in. Nothing here is a secret unless you choose the bearer-key route.

# The TTS endpoint to benchmark: a dedicated endpoint OCID (imported model on a DAC)
# or, for on-demand models that answer on the same speech route, the model name.
TTS_MODEL=ocid1.generativeaiendpoint.oc1.<region>.<endpoint-id>

# Compartment the endpoint lives in (sent as the compartment header).
GENAI_COMPARTMENT_ID=ocid1.compartment.oc1..<compartment-id>

# How to authenticate. One of:
#   api_key             ~/.oci/config profile (laptops, default)
#   resource_principal  OCI Data Science notebook sessions and jobs (auto-detected there)
#   instance_principal  OCI compute VMs with a dynamic group policy
#   security_token      `oci session authenticate` profiles
#   bearer              an OCI Generative AI API key, see GENAI_API_KEY
OCI_AUTH=api_key
OCI_CONFIG_PROFILE=DEFAULT

# Only for OCI_AUTH=bearer. Create it under Generative AI > API keys, in the SAME region as the endpoint.
# GENAI_API_KEY=sk-...

# Optional: force the inference host. Default is derived from the region in TTS_MODEL,
# or from OCI_REGION when TTS_MODEL is not an OCID.
# GENAI_SERVICE_ENDPOINT=https://inference.generativeai.<region>.oci.oraclecloud.com
# OCI_REGION=eu-frankfurt-1

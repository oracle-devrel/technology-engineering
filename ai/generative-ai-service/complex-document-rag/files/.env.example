# Oracle Cloud Infrastructure — Generative AI configuration
# Copy this file to `.env` and fill in your compartment. The model IDs below
# already use OCI's on-demand model NAMES, so they usually work as-is.

# Your compartment for Generative AI resources (this one is genuinely a compartment OCID).
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaa...

# ---------------------------------------------------------------------------
# Models — on-demand foundation models are addressed by NAME (vendor.model).
# No OCID needed. Names can vary by region/availability; list yours with:
#   oci generative-ai model-collection list-models \
#     --compartment-id "$OCI_COMPARTMENT_ID" --region us-chicago-1 --all
# ---------------------------------------------------------------------------
OCI_GROK_3_MODEL_ID=xai.grok-3
OCI_GROK_3_FAST_MODEL_ID=xai.grok-3-mini
OCI_GROK_4_MODEL_ID=xai.grok-4
OCI_GEMINI_2_5_PRO_MODEL_ID=google.gemini-2.5-pro
OCI_GPT_5_2_MODEL_ID=openai.gpt-5.2
OCI_LLAMA_3_3_MODEL_ID=meta.llama-3.3-70b-instruct
OCI_COHERE_COMMAND_A_MODEL_ID=cohere.command-a-03-2025

# ---------------------------------------------------------------------------
# Dedicated AI Cluster (DAC) — the ONE case where you use OCIDs, not names.
# Only needed if you serve a model on a dedicated cluster or use a fine-tuned
# / custom model. These are addressed by an ENDPOINT OCID and live in their
# own compartment. Leave commented unless you actually use a DAC.
# ---------------------------------------------------------------------------
# COMPARTMENT_ID_DAC=ocid1.compartment.oc1..aaaaaaaa...
# Example endpoint OCID (the built-in `dac-cluster` model sets this in
# llm_factory.py MODEL_REGISTRY, not here):
#   ocid1.generativeaiendpoint.oc1.<region>.aaaaaaaa...

# ---------------------------------------------------------------------------
# Optional settings
# ---------------------------------------------------------------------------
DEFAULT_EMBEDDING_MODEL=cohere-embed-multilingual-v3.0
DEFAULT_LLM_MODEL=grok-3

# Chunks retrieved per entity per section (the query UI slider overrides this).
# RESEARCH_TOP_K=4

# OCI config profile, if not using DEFAULT.
# OCI_CONFIG_PROFILE=DEFAULT

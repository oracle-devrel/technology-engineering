# Model registry — copy to .env and fill in. Auth comes from ~/.oci/config.
# The service-endpoint URL is derived from *_REGION; never paste it.
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..xxxxxxxx

# Active model slugs (first one is the default). A slug <name> reads <NAME>_* keys.
MODELS=vlm

# Any vision model behind the OCI Generative AI chat API works. Dedicated (hosting
# cluster) example — Qwen 3.8 27B was used to build and measure this asset:
VLM_MODE=dedicated
VLM_REGION=eu-frankfurt-1
VLM_ENDPOINT_OCID=ocid1.generativeaiendpoint.oc1.eu-frankfurt-1.xxxxxxxx
VLM_VISION=true

# On-demand example (comment the block above, uncomment this one):
# VLM_MODE=on_demand
# VLM_REGION=eu-frankfurt-1
# VLM_MODEL_ID=google.gemini-2.5-flash
# VLM_VISION=true

{
  "domain": "construction",
  "name": "Construction Document Intelligence",
  "description": "Extract data from AIP, WEP, RAMS, and technical submissions for construction projects",
  "fields": [
    {"name": "document_number", "label": "Document Number", "type": "text", "group": "metadata", "description": "Official document reference number"},
    {"name": "revision", "label": "Revision", "type": "text", "group": "metadata", "description": "Document revision (e.g., Rev 6, C01)"},
    {"name": "document_date", "label": "Date", "type": "date", "group": "metadata", "description": "Document issue date"},
    {"name": "document_status", "label": "Status", "type": "enum", "group": "metadata", "description": "Document status (e.g., S3 – Suitable for Review)"},
    {"name": "project_name", "label": "Project Name", "type": "text", "group": "metadata", "description": "Project title"},
    {"name": "project_number", "label": "Project Number", "type": "text", "group": "metadata", "description": "Project reference number"},
    {"name": "project_location", "label": "Project Location", "type": "text", "group": "metadata", "description": "Site address"},
    {"name": "client", "label": "Client", "type": "text", "group": "stakeholders", "description": "Client/owner name"},
    {"name": "designer", "label": "Designer", "type": "text", "group": "stakeholders", "description": "Design organization"},
    {"name": "checker", "label": "Checker", "type": "text", "group": "stakeholders", "description": "Independent checker organization"},
    {"name": "contractor", "label": "Contractor", "type": "text", "group": "stakeholders", "description": "Main contractor"},
    {"name": "principal_designer", "label": "Principal Designer", "type": "text", "group": "stakeholders", "description": "CDM principal designer"},
    {"name": "author", "label": "Author", "type": "text", "group": "stakeholders", "description": "Document author name and title"},
    {"name": "approver", "label": "Approver", "type": "text", "group": "stakeholders", "description": "Document approver (flag if missing)"},
    {"name": "structure_type", "label": "Structure Type", "type": "text", "group": "structure", "description": "Type of structure (basement, bridge, retaining wall)"},
    {"name": "foundation_type", "label": "Foundation Type", "type": "text", "group": "structure", "description": "Foundation system (piled raft, secant wall, etc.)"},
    {"name": "design_life", "label": "Design Life", "type": "text", "group": "structure", "description": "Design working life (years)"},
    {"name": "consequence_class", "label": "Consequence Class", "type": "text", "group": "structure", "description": "CC1/CC2/CC3"},
    {"name": "exposure_class", "label": "Exposure Class", "type": "text", "group": "structure", "description": "XC1/XC2/XC3/XC4"},
    {"name": "concrete_grade", "label": "Concrete Grade", "type": "text", "group": "materials", "description": "Concrete strength class (C30/37, C40/50, etc.)"},
    {"name": "steel_grade", "label": "Steel Grade", "type": "text", "group": "materials", "description": "Structural steel grade (S355, etc.)"},
    {"name": "rebar_grade", "label": "Reinforcement Grade", "type": "text", "group": "materials", "description": "Reinforcement steel grade (500B, etc.)"},
    {"name": "pile_types", "label": "Pile Types & Quantities", "type": "list", "group": "quantities", "description": "All pile types with diameters, quantities, and depths"},
    {"name": "slab_thickness", "label": "Slab Thicknesses", "type": "list", "group": "quantities", "description": "All slab thicknesses mentioned"},
    {"name": "retaining_height", "label": "Retaining Height", "type": "text", "group": "quantities", "description": "Maximum retained height"},
    {"name": "excavation_depth", "label": "Excavation Depth", "type": "text", "group": "quantities", "description": "Maximum excavation depth from ground level"},
    {"name": "construction_stages", "label": "Construction Stages", "type": "list", "group": "sequence", "description": "Ordered list of construction stages"},
    {"name": "soil_types", "label": "Soil Types", "type": "list", "group": "geotechnical", "description": "Soil strata with properties"},
    {"name": "groundwater_level", "label": "Groundwater Level", "type": "text", "group": "geotechnical", "description": "Groundwater level (mTD or mAOD)"},
    {"name": "design_standards", "label": "Design Standards", "type": "list", "group": "standards", "description": "All referenced standards (Eurocodes, BS EN, CD, CG, CIRIA)"},
    {"name": "traffic_speed", "label": "Design Traffic Speed", "type": "text", "group": "site", "description": "Design traffic speed for highway loading"},
    {"name": "highway_type", "label": "Highway Type", "type": "text", "group": "site", "description": "Road type"},
    {"name": "drawings_list", "label": "Drawings List", "type": "list", "group": "documents", "description": "All drawing numbers with titles"}
  ]
}

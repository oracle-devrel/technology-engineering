# Oracle Database
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DSN=your_tns_alias_or_tls_connect_descriptor

# Wallet-based mTLS. For walletless TLS, set USE_WALLET=false and provide the
# TLS connect descriptor in DB_DSN.
USE_WALLET=true
WALLET_LOCATION=/absolute/path/to/unzipped/wallet
WALLET_PASSWORD=your_wallet_password

# Connection pool
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_POOL_WAIT_TIMEOUT=10

# Existing Oracle Select AI profile
SELECT_AI_PROFILE=your_select_ai_profile

# OCI Generative AI. The OCI SDK also needs a local OCI configuration or an
# equivalent supported runtime identity; never add OCI private keys to Git.
OCI_COMPARTMENT_ID=your_compartment_ocid
OCI_GENAI_ENDPOINT=https://inference.generativeai.eu-frankfurt-1.oci.oraclecloud.com
OCI_GENAI_MODEL=cohere.command-a-03-2025

# API server
API_HOST=0.0.0.0
API_PORT=4060
CORS_ORIGINS=["http://localhost:3060","http://localhost:5173","http://localhost:3000"]

# Pipeline limits and timeouts
SENTIMENT_AGENT_TIMEOUT=120
ACTION_AGENT_TIMEOUT=120
WEB_SOURCE_AGENT_TIMEOUT=45
SENTIMENT_CONCURRENCY=3
WEB_SEARCH_CONCURRENCY=3
WEB_SCRAPE_CONCURRENCY=5
MAX_SEARCH_QUERIES=4
MAX_WEB_SEARCH_RESULTS=10
MAX_SCRAPE_TARGETS=10
SEARCH_RESULTS_PER_QUERY=8


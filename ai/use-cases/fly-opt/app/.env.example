# cuOPT API Configuration
VITE_CUOPT_ENDPOINT=https://cuopt-2-cuopt.137-131-27-21.nip.io

# OCI Generative AI Configuration
# Uses OCI SDK authentication via ~/.oci/config (no API key needed)
VITE_OCI_GENAI_ENDPOINT=https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com
VITE_OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your-compartment-ocid
# Model ID is the OCID of the model endpoint
VITE_OCI_GENAI_MODEL_ID=ocid1.generativeaimodel.oc1.phx.your-model-ocid

# Application Configuration
VITE_APP_TITLE=cuOPT AI Optimizer
VITE_PARALLEL_MAX_JOBS=8
VITE_DEFAULT_SOLVE_TIMEOUT=30

# Server Configuration (for Express proxy)
PORT=3001
CUOPT_ENDPOINT=https://cuopt-2-cuopt.137-131-27-21.nip.io
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-phoenix-1.oci.oraclecloud.com
OCI_GENAI_MODEL_ID=ocid1.generativeaimodel.oc1.phx.your-model-ocid
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your-compartment-ocid
OCI_CONFIG_PROFILE=DEFAULT

# Weather API Configuration (OpenWeatherMap)
# Get free API key at: https://openweathermap.org/api
# Leave empty to use mock weather data
OPENWEATHERMAP_API_KEY=

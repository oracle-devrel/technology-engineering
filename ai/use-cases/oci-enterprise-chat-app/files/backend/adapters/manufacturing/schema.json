{
  "domain": "manufacturing",
  "name": "Manufacturing Quality & Safety",
  "description": "Extract and analyze manufacturing quality control, safety compliance, and operational documents. Supports ISO 9001, OSHA, and environmental compliance standards.",
  "fields": [
    {"name": "document_title", "label": "Document Title", "type": "text", "group": "metadata", "description": "Title of the manufacturing document"},
    {"name": "document_number", "label": "Document Number", "type": "text", "group": "metadata", "description": "Document reference or SOP number"},
    {"name": "revision", "label": "Revision", "type": "text", "group": "metadata", "description": "Document revision number"},
    {"name": "effective_date", "label": "Effective Date", "type": "date", "group": "metadata", "description": "Date the document takes effect"},
    {"name": "facility", "label": "Facility / Plant", "type": "text", "group": "metadata", "description": "Manufacturing facility or plant name"},
    {"name": "author", "label": "Author / Prepared By", "type": "text", "group": "parties", "description": "Document author"},
    {"name": "approver", "label": "Approver", "type": "text", "group": "parties", "description": "Document approver"},
    {"name": "quality_manager", "label": "Quality Manager", "type": "text", "group": "parties", "description": "Quality assurance manager"},
    {"name": "safety_officer", "label": "Safety Officer", "type": "text", "group": "parties", "description": "Health and safety officer"},
    {"name": "product_specs", "label": "Product Specifications", "type": "list", "group": "quality", "description": "Product specifications and tolerances"},
    {"name": "quality_checks", "label": "Quality Control Checks", "type": "list", "group": "quality", "description": "Quality control checkpoints and criteria"},
    {"name": "inspection_procedures", "label": "Inspection Procedures", "type": "list", "group": "quality", "description": "Inspection methods and acceptance criteria"},
    {"name": "non_conformances", "label": "Non-Conformances", "type": "list", "group": "quality", "description": "Identified non-conformances and corrective actions"},
    {"name": "hazards_identified", "label": "Hazards Identified", "type": "list", "group": "safety", "description": "Workplace hazards and risk assessments"},
    {"name": "ppe_requirements", "label": "PPE Requirements", "type": "list", "group": "safety", "description": "Personal protective equipment requirements"},
    {"name": "safety_procedures", "label": "Safety Procedures", "type": "list", "group": "safety", "description": "Safety procedures and protocols"},
    {"name": "incident_reports", "label": "Incident Reports", "type": "list", "group": "safety", "description": "Safety incidents and near-misses"},
    {"name": "waste_management", "label": "Waste Management", "type": "list", "group": "environmental", "description": "Waste handling and disposal procedures"},
    {"name": "environmental_controls", "label": "Environmental Controls", "type": "list", "group": "environmental", "description": "Environmental monitoring and control measures"},
    {"name": "supplier_requirements", "label": "Supplier Requirements", "type": "list", "group": "supply_chain", "description": "Supplier quality and compliance requirements"},
    {"name": "traceability_records", "label": "Traceability Records", "type": "list", "group": "supply_chain", "description": "Material and product traceability information"},
    {"name": "training_requirements", "label": "Training Requirements", "type": "list", "group": "training", "description": "Required training programs and certifications"},
    {"name": "standards_referenced", "label": "Standards Referenced", "type": "list", "group": "references", "description": "ISO, OSHA, and other standards referenced"}
  ]
}

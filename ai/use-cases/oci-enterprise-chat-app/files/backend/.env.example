# AIQ RAG Application Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Upload Configuration
UPLOAD_DIR=uploads

# Application Admin Credentials (frontend login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Microsoft Entra ID / Active Directory (optional; all values are deployment secrets)
# Configure a Web redirect URI registered in Entra, e.g. https://app.example.com/auth/callback.
# The client secret is never returned by the API and should be supplied from a secret store.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_GROUP_SYNC_ENABLED=false

# LLM Endpoint Configuration (Llama Stack / OpenAI-compatible)
# This is the primary endpoint for all LLM inference and embedding services
RAG_ENDPOINT_URL=https://your-llm-endpoint.example.com
CORRINO_MODEL=default


# CORS Configuration (comma-separated list of additional origins)
CORS_ORIGINS=http://localhost:3000,https://<FRONTEND_HOSTNAME>

# Logging
LOG_LEVEL=INFO

# Oracle 23ai Vector Database Configuration
# Database connection settings for Oracle Autonomous Database with AI Vector Search
# The wallet files should be placed in the ORACLE_WALLET_DIR directory
ORACLE_DB_USERNAME=ADMIN
ORACLE_DB_PASSWORD=your-oracle-password-here
# DSN name from tnsnames.ora (options: _high, _medium, _low, _tp, _tpurgent)
ORACLE_DSN=<ORACLE_DATABASE_SERVICE_NAME>
# Path to wallet directory containing cwallet.sso, tnsnames.ora, etc.
ORACLE_WALLET_DIR=config/wallet
# Table name for storing document vectors
ORACLE_VECTOR_TABLE=document_vectors
# Embedding dimension (default: 1536 for OpenAI embeddings)
ORACLE_EMBEDDING_DIMENSION=1536

# Embedding Service Configuration
# Optional - defaults to RAG_ENDPOINT_URL if not set
# EMBEDDING_API_URL=https://your-embedding-endpoint.example.com
EMBEDDING_MODEL=oci/cohere.embed-multilingual-v3.0

# Batch Processing Configuration
# Maximum number of files to process in parallel within a batch job (1-5)
MAX_BATCH_PARALLELISM=5
